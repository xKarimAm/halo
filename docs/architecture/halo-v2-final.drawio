<mxfile host="Claude" version="24.0.0"><diagram id="halo-v2-final" name="Halo v2 final"><mxGraphModel dx="2400" dy="1800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0" adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Halo v2 · FINAL architecture&lt;/b&gt; (2026-10-30, for Karim's review; then the XML goes to Muse for PLAN.md). Base = draft 4 Test-first + draft 2 browser face detector (MAIN face path, frames never leave the browser) + draft 5 data-plane / control-plane rule. Box = what the module does (italic line = wave + offline test). Arrow = contract (⇄ ACK = acknowledged envelope). Grey mono box = JSON type, plain dashed line to the module that emits it. &lt;font color=&quot;#c92a2a&quot;&gt;&lt;b&gt;Thick red = critical path.&lt;/b&gt;&lt;/font&gt;" style="text;html=1;fontSize=14;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="6" width="3700" height="48" as="geometry"/></mxCell><mxCell id="L_wave" value="Build waves: contracts first, then the test rig, then modules. Arrow = unblocks. A wave merges only when its offline tests are green in CI." style="swimlane;startSize=30;html=1;fontSize=13;fontStyle=1;fillColor=#f7f1fa;strokeColor=#9673a6;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="3700" height="300" as="geometry"/></mxCell><mxCell id="w0" value="&lt;b&gt;Wave 0 · /contracts · Oct 31 morning (window W1)&lt;/b&gt;&lt;br&gt;Envelope + ACK rules (ACK on the socket only), the two-plane rule, one JSON Schema per event + a markdown catalog, clock + coordinate rules, MeetingAdapter interface, codegen (pydantic + TS), a golden sample per type, socket ACK tests, import-linter, CI workflow + PR template.&lt;br&gt;&lt;br&gt;&lt;i&gt;Done = every golden sample validates, codegen committed, CI green.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fontSize=10;" vertex="1" parent="L_wave"><mxGeometry x="30" y="50" width="460" height="220" as="geometry"/></mxCell><mxCell id="w1" value="&lt;b&gt;Wave 1 · LEAN test rig · Oct 31-Nov 1 (window W3)&lt;/b&gt;&lt;br&gt;Fake Meet page (grows from rig/fake_meet/seed-fixture.html; serves Meet's CSP + Trusted Types; video + canvas-only modes; CC0 photo faces) + Playwright, FakeASR, FakeLLM, Replayer (mode A fake extension, mode B fake backend). CI golden = a committed synthetic fixture. Karim's recorded calls (OBS: screen + separate desktop and mic tracks) stay local for the L4 real run.&lt;br&gt;&lt;i&gt;Done = the synthetic fixture replays through the Gateway and the asserts pass.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fontSize=10;" vertex="1" parent="L_wave"><mxGeometry x="550" y="50" width="560" height="220" as="geometry"/></mxCell><mxCell id="w2" value="&lt;b&gt;Wave 2 · Backend critical path · Oct 31-Nov 1 (window W1)&lt;/b&gt;&lt;br&gt;Gateway (pairing, ACK, dedupe, system.status), EventBus, Event Store, Transcriber, Correlator, Insight.&lt;br&gt;&lt;i&gt;Done = replay golden (L2) green with the fakes.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fontSize=10;" vertex="1" parent="L_wave"><mxGeometry x="1170" y="40" width="600" height="120" as="geometry"/></mxCell><mxCell id="w3" value="&lt;b&gt;Wave 3 · Extension critical path · Oct 31-Nov 1 (windows W2 + W3)&lt;/b&gt;&lt;br&gt;W2: Setup Panel, Meet Adapter, Frame Source. W3: Hub + Capture, Face Detector, Overlay.&lt;br&gt;&lt;i&gt;Done = Playwright on the Fake Meet page (L3) green.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fontSize=10;" vertex="1" parent="L_wave"><mxGeometry x="1170" y="170" width="600" height="120" as="geometry"/></mxCell><mxCell id="w4" value="&lt;b&gt;Wave 4 · Integrate · Nov 1 night → Nov 2&lt;/b&gt;&lt;br&gt;Nov 1 night: THIN end-to-end on the Replay rig (audio → transcript → point → bubble, Frame mode).&lt;br&gt;Nov 2: Face mode + live Meet; second ring: Classifier, Notes Builder, Notes Service, Notes page, Recorder.&lt;br&gt;&lt;br&gt;&lt;i&gt;Done = full replay golden incl. notes.ready + tags.set, plus Notes page HTTP snapshot tests.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fontSize=10;" vertex="1" parent="L_wave"><mxGeometry x="1830" y="50" width="520" height="220" as="geometry"/></mxCell><mxCell id="w5" value="&lt;b&gt;Wave 5 · Ship · Nov 2 night → submit Nov 3&lt;/b&gt;&lt;br&gt;Nov 2 night: live Meet rehearsal (L5), cut list applied to anything not solid. Packaging: README install steps + one command (&lt;i&gt;halo&lt;/i&gt;) that starts the backend and prints the pairing code.&lt;br&gt;Nov 3: record the 3-min demo video, submit (public repo + video).&lt;br&gt;&lt;i&gt;Done = submitted.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fontSize=10;" vertex="1" parent="L_wave"><mxGeometry x="2410" y="50" width="480" height="220" as="geometry"/></mxCell><mxCell id="ladder" value="&lt;b&gt;Test ladder: what runs where&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;L0 contract: schemas + golden samples ...... every PR, $0&lt;br&gt;L1 module unit tests with fakes ............ every PR, $0&lt;br&gt;L2 replay golden, backend (Replayer A) ..... every PR, $0&lt;br&gt;L3 Playwright on Fake Meet (Replayer B) .... every PR, $0&lt;br&gt;L4 real-engine smoke on one fixture ...... on demand, capped&lt;br&gt;L5 live Meet rehearsal ................. before demo, Karim&lt;/font&gt;&lt;br&gt;&lt;br&gt;CI runs L0-L3 only: no keys, no GPU, no network. L3 opens the hub with ?halo_test=1 (no toolbar click needed); the Face Detector runs on CC0 photo faces." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fontSize=10;" vertex="1" parent="L_wave"><mxGeometry x="2950" y="40" width="720" height="245" as="geometry"/></mxCell><mxCell id="s01" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitPerimeter=0;entryPerimeter=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="L_wave" source="w0" target="w1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitPerimeter=0;entryPerimeter=0;exitX=1;exitY=0.2273;entryX=0;entryY=0.5;" edge="1" parent="L_wave" source="w1" target="w2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitPerimeter=0;entryPerimeter=0;exitX=1;exitY=0.8182;entryX=0;entryY=0.5;" edge="1" parent="L_wave" source="w1" target="w3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitPerimeter=0;entryPerimeter=0;exitX=1;exitY=0.5;entryX=0;entryY=0.2273;" edge="1" parent="L_wave" source="w2" target="w4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitPerimeter=0;entryPerimeter=0;exitX=1;exitY=0.5;entryX=0;entryY=0.8182;" edge="1" parent="L_wave" source="w3" target="w4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s45" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitPerimeter=0;entryPerimeter=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="L_wave" source="w4" target="w5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="legend" value="&lt;b&gt;Key&lt;/b&gt;&lt;br&gt;Box = what the module does; italic line = the wave that builds it + its offline test. Arrow = contract on the label; ⇄ ACK = acknowledged envelope, on the extension ⇄ Gateway socket only. Grey mono box = JSON type, plain dashed line to its module.&lt;br&gt;&lt;b&gt;Data plane&lt;/b&gt; (binary audio + rec chunks): no envelope, no ACK. &lt;b&gt;Control plane&lt;/b&gt;: envelopes ⇄ ACK. Green dashed arrow = in-tab call, never on the wire.&lt;br&gt;&lt;br&gt;Colours: green = extension · blue = backend · red = paid model API · purple = test tooling (never shipped) · white = /contracts · yellow = notes for Karim. &lt;font color=&quot;#c92a2a&quot;&gt;&lt;b&gt;Thick red border/arrow = critical path&lt;/b&gt;&lt;/font&gt;; &lt;font color=&quot;#c92a2a&quot;&gt;&lt;i&gt;✂ n&lt;/i&gt;&lt;/font&gt; = cut line n; &lt;i&gt;ring 2&lt;/i&gt; = second ring.&lt;br&gt;Inside the backend every arrow is an EventBus topic (publish returns an ack at once, no resend); the Event Store taps all of them. One meeting clock (browser ts_ms)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="700" height="220" as="geometry"/></mxCell><mxCell id="L_notes" value="Browser tab: Notes page (served by the backend) · ring 2" style="swimlane;startSize=30;html=1;fontSize=13;fontStyle=1;fillColor=#fafafa;strokeColor=#999999;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="780" y="400" width="700" height="200" as="geometry"/></mxCell><mxCell id="notespage" value="&lt;b&gt;Notes page&lt;/b&gt;&lt;br&gt;Build from &lt;i&gt;docs/ui/notes-v2.html?palette=2&lt;/i&gt; (People First, Sage &amp;amp; Clay). Meeting list + search; per person: role, relevant points, own points, action items grouped Urgent / Medium / Later. Points link to transcript line + recording moment. One-click re-tag.&lt;br&gt;&lt;font color=&quot;#c92a2a&quot;&gt;&lt;i&gt;✂ 5 re-tag menu · ✂ 6 Arabic polish beyond RTL&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;i&gt;Wave 4 · test: HTTP snapshots on a replay-seeded DB.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fontSize=10;" vertex="1" parent="L_notes"><mxGeometry x="360" y="35" width="300" height="150" as="geometry"/></mxCell><mxCell id="t_http" value="HTTP (JSON, no envelope)&#10;GET  /notes/{meeting_id} -&gt; HTML shell&#10;GET  /api/meetings/{id} -&gt; page JSON&#10;GET  /api/meetings?project_id=&#10;GET  /api/search?q=&#10;GET  /api/meetings/{id}/export.md&#10;POST /api/tags { target, target_id,&#10;  kind?, urgency? }&#10;GET /pair  POST /pair {code}-&gt;{token}" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=6;fontSize=9;fontFamily=Courier New;" vertex="1" parent="L_notes"><mxGeometry x="20" y="35" width="300" height="165" as="geometry"/></mxCell><mxCell id="p_notespage" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="L_notes" source="t_http" target="notespage"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="crit" value="&lt;b&gt;&lt;font color=&quot;#c92a2a&quot;&gt;Critical path&lt;/font&gt; (DECISIONS §8: the demo dies if any link fails)&lt;/b&gt;&lt;br&gt;Tab + Mic Capture → Gateway → Transcriber → Correlator → Insight → Gateway → Overlay, plus Meet Adapter (tiles, names, speaking highlight) → Frame Source → Face Detector → Overlay. Integrate and demo this chain end to end FIRST on the Replay rig, then live.&lt;br&gt;&lt;b&gt;Second ring:&lt;/b&gt; Event Store, Notes Service + Notes page, Setup Panel, Classifier.&lt;br&gt;&lt;b&gt;Cut lines, in this order if time runs out:&lt;/b&gt; ✂1 SAM 3.1 stretch · ✂2 Zoom/Teams adapters · ✂3 Recorder (keep transcript links, drop video) · ✂4 Notes Builder per-person depth (keep live points + action list) · ✂5 re-tag menu · ✂6 Arabic UI polish beyond RTL correctness.&lt;br&gt;&lt;b&gt;Never cut:&lt;/b&gt; consent badge, the critical path, contract validation.&lt;br&gt;&lt;b&gt;Rules:&lt;/b&gt; everyone in a Halo call wears a headset (echo). Crosstalk: a turn with two speakers is marked overlap; the demo script avoids it. &lt;b&gt;Deadline: submit Nov 3.&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff5f5;strokeColor=#c92a2a;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2820" y="400" width="920" height="220" as="geometry"/></mxCell><mxCell id="e_http" value="HTTP GET /notes, /api/*, /pair · POST /api/tags" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitPerimeter=0;entryPerimeter=0;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="notespage" target="gw"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1780" y="510"/></Array></mxGeometry></mxCell><mxCell id="L_con" value="/contracts (Wave 0): the only thing modules share · codegen → TS types (extension) + pydantic (backend)" style="swimlane;startSize=30;html=1;fontSize=13;fontStyle=1;fillColor=#fafafa;strokeColor=#999999;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="700" height="1360" as="geometry"/></mxCell><mxCell id="c_ack" value="&lt;b&gt;Envelope + ACK rules&lt;/b&gt;&lt;br&gt;Every JSON message is a CloudEvents 1.0 envelope.&lt;br&gt;&lt;b&gt;ACK lives on the socket&lt;/b&gt; (extension ⇄ Gateway, the only place a message can get lost): ACK = validated, deduped, on the bus. The hub keeps an outbox: no ACK in 2 s, or a reconnect → resend the SAME id (3 tries, then status degraded). Gateway and Overlay dedupe by id.&lt;br&gt;&lt;b&gt;Inside the backend&lt;/b&gt; bus.publish() returns a typed Ack at once: same schema, no retries.&lt;br&gt;Model outputs are always schema-validated." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fontSize=10;" vertex="1" parent="L_con"><mxGeometry x="20" y="40" width="320" height="230" as="geometry"/></mxCell><mxCell id="t_env" value="envelope (CloudEvents 1.0)&#10;{ specversion: &quot;1.0&quot;, id, type,&#10;  source, time, meetingid,&#10;  datacontenttype:&#10;    &quot;application/json&quot;,&#10;  data: {...} }&#10;&#10;ACK&#10;{ ack_of: id,&#10;  status: &quot;ok&quot;|&quot;error&quot;,&#10;  error?: { code, message } }&#10;duplicate id -&gt; ACK ok again,&#10;  do not re-apply" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=6;fontSize=9;fontFamily=Courier New;" vertex="1" parent="L_con"><mxGeometry x="360" y="40" width="320" height="230" as="geometry"/></mxCell><mxCell id="p_c_ack" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="L_con" source="t_env" target="c_ack"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c_plane" value="&lt;b&gt;Two planes (from draft 5)&lt;/b&gt;&lt;br&gt;&lt;b&gt;Data plane&lt;/b&gt; = binary on the one WebSocket: audio + recording chunks. No envelope, no ACK, no retry, no id. Audio is lossless + ordered (backpressure, not drops). Face frames never cross the wire; the only video sent is the local recording (rec chunks).&lt;br&gt;&lt;b&gt;Control plane&lt;/b&gt; = envelopes ⇄ ACK only: lifecycle, context, transcripts, points, tags, status, pairing.&lt;br&gt;&lt;b&gt;Converters&lt;/b&gt; are the only bridge (binary in, envelopes out): Transcriber, Recorder." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fontSize=10;" vertex="1" parent="L_con"><mxGeometry x="20" y="300" width="320" height="230" as="geometry"/></mxCell><mxCell id="t_plane" value="data-plane rules (Gateway data side)&#10;audio kind=1: lossless, ordered FIFO&#10;  per stream; seq gap -&gt; silence&#10;  pad + gap logged; bound 30 s,&#10;  then system.status warn&#10;rec   kind=3: lossless append;&#10;  disk lag -&gt; spill to temp&#10;face frames: NOT on the wire (in-tab);&#10;  recording video = rec chunks&#10;never: ACKs, retries, ids on binary&#10;&#10;control plane: envelopes only,&#10;  ACK, resend same id, dedupe" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=6;fontSize=9;fontFamily=Courier New;" vertex="1" parent="L_con"><mxGeometry x="360" y="300" width="320" height="230" as="geometry"/></mxCell><mxCell id="p_c_plane" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="L_con" source="t_plane" target="c_plane"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c_cat" value="&lt;b&gt;Event catalog&lt;/b&gt;&lt;br&gt;One JSON Schema per type + a markdown table (type → emitter → consumers). In-tab messages (TileFrame, faces.update) are typed too, never sent.&lt;br&gt;Future-proofing, added now: &lt;b&gt;project_id&lt;/b&gt; (optional) on meeting.context; &lt;b&gt;platform&lt;/b&gt; on meeting.started (MeetingAdapter); faces.update is &lt;b&gt;engine-agnostic&lt;/b&gt;; &lt;b&gt;meeting_id&lt;/b&gt; is a UUID minted by the hub at Start." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fontSize=10;" vertex="1" parent="L_con"><mxGeometry x="20" y="560" width="320" height="240" as="geometry"/></mxCell><mxCell id="t_cat" value="pair.hello { token, ext_version }&#10;pair.ok { session_id } | pair.rejected&#10;meeting.started { meeting_id (UUID),&#10;  platform: &quot;meet&quot;|&quot;zoom&quot;|&quot;teams&quot;,&#10;  meeting_code, t0_ms, self_name }&#10;meeting.ended { reason: left|&#10;  tab_closed|timeout }&#10;  (Gateway: after 60 s with no WS)&#10;system.status {&#10;  asr: ok|reconnecting|down,&#10;  llm: { engine, failover: bool },&#10;  tagger: ok|down, outbox_backlog }" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=6;fontSize=9;fontFamily=Courier New;" vertex="1" parent="L_con"><mxGeometry x="360" y="560" width="320" height="240" as="geometry"/></mxCell><mxCell id="p_c_cat" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="L_con" source="t_cat" target="c_cat"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c_clk" value="&lt;b&gt;Clock + coordinate rules&lt;/b&gt;&lt;br&gt;&lt;b&gt;One meeting clock&lt;/b&gt;: browser epoch ms (performance.timeOrigin + now), stamped once at the source in the extension. t0 = meeting.started.t0_ms. The backend never re-stamps meeting time; envelope.time is server wall clock, for logs only.&lt;br&gt;&lt;b&gt;Boxes&lt;/b&gt; are 0..1 of the SOURCE FRAME (frame_w × frame_h of the tile video). Only the Overlay converts to screen, with tile rect + video size + object-fit." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fontSize=10;" vertex="1" parent="L_con"><mxGeometry x="20" y="830" width="320" height="240" as="geometry"/></mxCell><mxCell id="t_clk" value="ts_ms: u64, browser epoch ms&#10;t_rel = ts_ms - t0_ms&#10;&#10;ASR turn time:&#10;  ts = anchor_ts + asr_offset&#10;  (Transcriber keeps seq -&gt; ts_ms&#10;   of the frames it paced, pads incl.)&#10;&#10;box space &quot;source&quot;:&#10;  { frame_w, frame_h,&#10;    box: [x,y,w,h] in 0..1 }&#10;screen = project(box, tile_rect,&#10;  video_w, video_h, object_fit)" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=6;fontSize=9;fontFamily=Courier New;" vertex="1" parent="L_con"><mxGeometry x="360" y="830" width="320" height="240" as="geometry"/></mxCell><mxCell id="p_c_clk" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="L_con" source="t_clk" target="c_clk"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c_kit" value="&lt;b&gt;Codegen + contract tests&lt;/b&gt;&lt;br&gt;JSON Schema → pydantic models (backend) and TS types (extension), one command. A golden sample per type, validated in CI. Socket tests: drop an ACK → resend the same id; send a duplicate → one row. import-linter keeps backend modules in their lanes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fontSize=10;" vertex="1" parent="L_con"><mxGeometry x="20" y="1100" width="320" height="220" as="geometry"/></mxCell><mxCell id="t_kit" value="validate(golden/*.json)&#10;socket: drop_ack -&gt; resend same id&#10;socket: duplicate -&gt; 1 row&#10;assert_monotonic(ts_ms)&#10;import-linter: module lanes" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=6;fontSize=9;fontFamily=Courier New;" vertex="1" parent="L_con"><mxGeometry x="360" y="1100" width="320" height="160" as="geometry"/></mxCell><mxCell id="p_c_kit" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="L_con" source="t_kit" target="c_kit"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L_ext" value="Chrome extension (WXT/TS, no keys). ONE WebSocket, held by the offscreen doc (alive for the whole capture); Setup Panel, Meet Adapter + Overlay reach it over a chrome.runtime Port" style="swimlane;startSize=30;html=1;fontSize=13;fontStyle=1;fillColor=#fafafa;strokeColor=#999999;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="780" y="640" width="700" height="1170" as="geometry"/></mxCell><mxCell id="setup" value="&lt;b&gt;Setup Panel&lt;/b&gt; (toolbar popup)&lt;br&gt;Its Start click is the user gesture tabCapture needs. Pairing UI: type the 6-digit code once; token in chrome.storage.local (manifest key pinned so the extension id never changes). Subject, agenda, roles, language, optional project → meeting.context. Consent: copies the chat notice to the clipboard; badge always on.&lt;br&gt;&lt;font color=&quot;#c92a2a&quot;&gt;&lt;i&gt;ring 2 (consent badge: never cut)&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;i&gt;Wave 3 · test: Playwright + Replayer B.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fontSize=10;" vertex="1" parent="L_ext"><mxGeometry x="360" y="40" width="300" height="150" as="geometry"/></mxCell><mxCell id="t_setup" value="POST /pair {code} -&gt; {token}&#10;meeting.context&#10;{ subject, agenda,&#10;  roles: [{ name, role }],&#10;  viewer_lang: &quot;en&quot;|&quot;ar&quot;,&#10;  project_id?: string }" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=6;fontSize=9;fontFamily=Courier New;" vertex="1" parent="L_ext"><mxGeometry x="20" y="40" width="300" height="120" as="geometry"/></mxCell><mxCell id="p_setup" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="L_ext" source="t_setup" target="setup"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cap" value="&lt;b&gt;Hub + Tab/Mic Capture&lt;/b&gt; (offscreen doc)&lt;br&gt;Opened by Start: mints meeting_id, holds the one WebSocket (pair.hello on every connect, envelope outbox), relays Port messages to the Meet-page modules. tabCapture (others) + mic (you; headset). 16 kHz PCM16, 100 ms frames stamped ts_ms; replays tab audio; webm of tab + mic for the Recorder.&lt;br&gt;&lt;i&gt;Wave 3 · test: ?halo_test=1 opens it with fixture audio.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fontSize=10;strokeColor=#c92a2a;strokeWidth=3;" vertex="1" parent="L_ext"><mxGeometry x="360" y="230" width="300" height="150" as="geometry"/></mxCell><mxCell id="t_cap" value="binary audio (data plane)&#10;[kind=1][stream: tab|mic]&#10;[seq u32][ts_ms u64]&#10;+ PCM16 mono 16 kHz, 100 ms&#10;binary rec chunk (data plane)&#10;[kind=3][seq u32][ts_ms u64]&#10;+ webm" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=6;fontSize=9;fontFamily=Courier New;" vertex="1" parent="L_ext"><mxGeometry x="20" y="230" width="300" height="120" as="geometry"/></mxCell><mxCell id="p_cap" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="L_ext" source="t_cap" target="cap"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="adp" value="&lt;b&gt;Meet Adapter&lt;/b&gt; (implements MeetingAdapter)&lt;br&gt;The only module that knows Meet's DOM (data-participant-id, never class names): tiles, names, self tile (mirrored), speaking highlight, tile rect, &amp;lt;video&amp;gt;, object-fit. Reports join/leave to the hub, which sends meeting.started / .ended.&lt;br&gt;&lt;font color=&quot;#c92a2a&quot;&gt;&lt;i&gt;✂ 2 Zoom/Teams adapters (roadmap)&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;i&gt;Wave 3 · test: Fake Meet layouts, join/leave, share.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fontSize=10;strokeColor=#c92a2a;strokeWidth=3;" vertex="1" parent="L_ext"><mxGeometry x="360" y="420" width="300" height="150" as="geometry"/></mxCell><mxCell id="t_adp" value="interface MeetingAdapter {&#10;  platform: &quot;meet&quot;|&quot;zoom&quot;|&quot;teams&quot;&#10;  matches(url): bool&#10;  tiles(): Tile[]  // id, name, is_self,&#10;    rect, video?: HTMLVideoElement,&#10;    video_w, video_h, fit&#10;  onTiles(cb) onSpeaking(cb)&#10;  onJoin(cb)  onLeave(cb) }&#10;tiles.snapshot { tiles: [...],&#10;  captions_rect?: rect|null }&#10;speaker.active {tile_id,speaking,ts_ms}" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=6;fontSize=9;fontFamily=Courier New;" vertex="1" parent="L_ext"><mxGeometry x="20" y="420" width="300" height="165" as="geometry"/></mxCell><mxCell id="p_adp" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="L_ext" source="t_adp" target="adp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="frm" value="&lt;b&gt;Frame Source&lt;/b&gt; (in-tab)&lt;br&gt;Draws each tile's &amp;lt;video&amp;gt; to an OffscreenCanvas, ~10 fps, ≤ 6 tiles. Face frames never leave the browser. If the meet-overlay probe finds no &amp;lt;video&amp;gt;: no face tracking, Frame mode for every tile (path B cut on 2026-10-30: a video track can't cross from the capture page to Meet's page).&lt;br&gt;&lt;i&gt;Wave 3 · test: Fake Meet video + canvas-only modes.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fontSize=10;strokeColor=#c92a2a;strokeWidth=3;" vertex="1" parent="L_ext"><mxGeometry x="360" y="610" width="300" height="150" as="geometry"/></mxCell><mxCell id="t_frm" value="TileFrame (in-tab, never sent)&#10;{ tile_id, ts_ms,&#10;  bitmap: ImageBitmap,&#10;  frame_w, frame_h }&#10;(frame_w/h = the space&#10; faces.update boxes use)" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=6;fontSize=9;fontFamily=Courier New;" vertex="1" parent="L_ext"><mxGeometry x="20" y="610" width="300" height="120" as="geometry"/></mxCell><mxCell id="p_frm" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="L_ext" source="t_frm" target="frm"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="det" value="&lt;b&gt;Face Detector&lt;/b&gt; (MAIN face path)&lt;br&gt;MediaPipe Face Detector (BlazeFace short-range, WASM + model bundled, no CDN), ~1-2 ms per tile, in a Worker inside a hidden extension iframe (own origin + CSP); the content script transfers ImageBitmaps to it. Smooths boxes, one track per tile; head anchor from eye/nose key points. No face, or tiles beyond 6 → Frame mode.&lt;br&gt;&lt;i&gt;Wave 3 · test: CC0 photo faces on Fake Meet, IoU ≥ 0.7.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fontSize=10;strokeColor=#c92a2a;strokeWidth=3;" vertex="1" parent="L_ext"><mxGeometry x="360" y="800" width="300" height="150" as="geometry"/></mxCell><mxCell id="t_det" value="faces.update (in-tab, engine-agnostic)&#10;{ tile_id, frame_ts_ms,&#10;  engine: &quot;mediapipe&quot;|&quot;yunet&quot;|&quot;sam&quot;,&#10;  space: { frame_w, frame_h },&#10;  face: { box: [x,y,w,h] 0..1,&#10;          head_anchor: [x,y],&#10;          conf } | null }&#10;null -&gt; Overlay uses Frame mode" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=6;fontSize=9;fontFamily=Courier New;" vertex="1" parent="L_ext"><mxGeometry x="20" y="800" width="300" height="150" as="geometry"/></mxCell><mxCell id="p_det" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="L_ext" source="t_det" target="det"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ovl" value="&lt;b&gt;Overlay&lt;/b&gt;&lt;br&gt;Build from &lt;i&gt;docs/ui/overlay-mix-b.html&lt;/i&gt;. Projects boxes to screen with tile rect + video size + object-fit (flip x on the mirrored self tile). Name above the head = the halo; ≤ 3 glass bubbles, fade ~60 s, same id replaces in place; urgent mark from tags.set; notes-ready toast. DOM via textContent only (Meet enforces Trusted Types). Status chip + consent badge.&lt;br&gt;&lt;font color=&quot;#c92a2a&quot;&gt;&lt;i&gt;✂ 6 Arabic polish beyond RTL&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;i&gt;Wave 3 · test: Replayer B → DOM ±4 px.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fontSize=10;strokeColor=#c92a2a;strokeWidth=3;" vertex="1" parent="L_ext"><mxGeometry x="360" y="990" width="300" height="150" as="geometry"/></mxCell><mxCell id="adp_frm" value="tile rects + &amp;lt;video&amp;gt; refs (in-tab)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitPerimeter=0;entryPerimeter=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;dashed=1;strokeColor=#c92a2a;strokeWidth=3;" edge="1" parent="L_ext" source="adp" target="frm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="frm_det" value="TileFrame (in-tab)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitPerimeter=0;entryPerimeter=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;dashed=1;strokeColor=#c92a2a;strokeWidth=3;" edge="1" parent="L_ext" source="frm" target="det"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="det_ovl" value="faces.update (in-tab, every frame)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitPerimeter=0;entryPerimeter=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;dashed=1;strokeColor=#c92a2a;strokeWidth=3;" edge="1" parent="L_ext" source="det" target="ovl"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="adp_ovl" value="tile rects, fit, is_self (in-tab)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitPerimeter=0;entryPerimeter=0;exitX=1;exitY=0.85;entryX=1;entryY=0.15;dashed=1;strokeColor=#c92a2a;strokeWidth=3;" edge="1" parent="L_ext" source="adp" target="ovl"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="690" y="547"/><mxPoint x="690" y="1012"/></Array></mxGeometry></mxCell><mxCell id="L_be" value="Backend: one FastAPI modular monolith on this PC (asyncio EventBus, SQLite + FTS5 + local files)" style="swimlane;startSize=30;html=1;fontSize=13;fontStyle=1;fillColor=#fafafa;strokeColor=#999999;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1620" y="640" width="1140" height="1560" as="geometry"/></mxCell><mxCell id="gw" value="&lt;b&gt;Gateway&lt;/b&gt;&lt;br&gt;The backend's only front door. Wave 2.&lt;br&gt;&lt;br&gt;Pairing: serves /pair (6-digit code → token). The first WS message must be pair.hello with a valid token; Origin must be the pinned extension id; HTTP checks the Host header (127.0.0.1 only: DNS-rebinding guard).&lt;br&gt;&lt;br&gt;&lt;b&gt;Data side&lt;/b&gt; (binary, no ACK): audio by stream → Transcriber (ordered, lossless); rec chunks → Recorder.&lt;br&gt;&lt;br&gt;&lt;b&gt;Control side&lt;/b&gt;: validates every envelope against /contracts, dedupes by id, publishes on the EventBus, then ACKs. This socket is the ONLY place with ACK + resend; inside the backend, bus.publish() returns an ack at once.&lt;br&gt;&lt;br&gt;Builds system.status from each module's health() (in-process call); pushes it every 5 s and on change. Synthesizes meeting.ended only after 60 s without a WS (grace for reloads and restarts).&lt;br&gt;&lt;br&gt;Serves the Notes page over HTTP; POST /api/tags → tags.set (source: user).&lt;br&gt;&lt;br&gt;&lt;i&gt;Wave 2 · test: L0 contract tests + socket resend/duplicate → one row per id.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fontSize=10;strokeColor=#c92a2a;strokeWidth=3;" vertex="1" parent="L_be"><mxGeometry x="40" y="40" width="240" height="1480" as="geometry"/></mxCell><mxCell id="tr" value="&lt;b&gt;Transcriber&lt;/b&gt; (converter)&lt;br&gt;Two Voice sessions (tab: diarization, mic: endpointing &quot;you&quot;), languageBias Arabic + English. Maps ASR offsets to the meeting clock (ts = anchor_ts + offset). Emits final turns only. Closes both sessions on meeting.ended.&lt;br&gt;&lt;i&gt;Wave 2 · test: FakeASR + fixture: t_start ±200 ms of truth.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fontSize=10;strokeColor=#c92a2a;strokeWidth=3;" vertex="1" parent="L_be"><mxGeometry x="380" y="40" width="300" height="150" as="geometry"/></mxCell><mxCell id="t_tr" value="transcript.final&#10;{ turn_id, stream: &quot;tab&quot;|&quot;mic&quot;,&#10;  speaker: &quot;A&quot;|&quot;B&quot;|...|&quot;you&quot;,&#10;  text, lang,&#10;  ts_start_ms, ts_end_ms }" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=6;fontSize=9;fontFamily=Courier New;" vertex="1" parent="L_be"><mxGeometry x="760" y="40" width="340" height="120" as="geometry"/></mxCell><mxCell id="p_tr" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="L_be" source="t_tr" target="tr"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="co" value="&lt;b&gt;Correlator&lt;/b&gt;&lt;br&gt;Attaches a tile + name to every final turn → turn.attributed. Before lock: the tile lit when the turn started (provisional; lag_ms knob, since Meet's highlight trails audio ~0.3-1 s). Locks after 3 agreeing turns; a disagreeing lock emits corrects[]. Two tiles lit → overlap. Drops a 'you' line that repeats a tab line within 2 s (echo).&lt;br&gt;&lt;i&gt;Wave 2 · test: wrong-highlight fixture → golden shows the fix.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fontSize=10;strokeColor=#c92a2a;strokeWidth=3;" vertex="1" parent="L_be"><mxGeometry x="380" y="230" width="300" height="150" as="geometry"/></mxCell><mxCell id="t_co" value="turn.attributed&#10;{ turn_id, text, lang, ts_start_ms,&#10;  ts_end_ms, tile_id, name,&#10;  attribution: provisional|locked,&#10;  overlap: bool }&#10;speaker.mapped { speaker, tile_id,&#10;  name, locked, corrects?: [turn_id] }" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=6;fontSize=9;fontFamily=Courier New;" vertex="1" parent="L_be"><mxGeometry x="760" y="230" width="340" height="120" as="geometry"/></mxCell><mxCell id="p_co" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="L_be" source="t_co" target="co"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ins" value="&lt;b&gt;Insight&lt;/b&gt;&lt;br&gt;On each turn.attributed (≤ 1 call / 3 s / speaker; ≤ 12 RPM until Baseten confirms 120): Spark Open, validate JSON. Per call, falls back to the contributor model on &amp;gt; 4 s, bad JSON twice or 429; tries Spark Open again after 30 s. Points in the viewer's language + quote + first-guess urgency; engine recorded on each point. On corrects[] it re-upserts with replaces.&lt;br&gt;&lt;i&gt;Wave 2 · test: FakeLLM latency + bad-JSON knobs.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fontSize=10;strokeColor=#c92a2a;strokeWidth=3;" vertex="1" parent="L_be"><mxGeometry x="380" y="420" width="300" height="150" as="geometry"/></mxCell><mxCell id="t_ins" value="points.upsert&#10;{ point_id, tile_id, speaker_name,&#10;  kind: point|question|decision|pushback,&#10;  text, lang, quote, turn_ids[], rank,&#10;  attribution, urgency?, is_action,&#10;  engine, replaces?: point_id }&#10;llm.health { engine, p90_ms }" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=6;fontSize=9;fontFamily=Courier New;" vertex="1" parent="L_be"><mxGeometry x="760" y="420" width="340" height="120" as="geometry"/></mxCell><mxCell id="p_ins" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="L_be" source="t_ins" target="ins"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cls" value="&lt;b&gt;Classifier&lt;/b&gt; (live urgency)&lt;br&gt;Off the critical path: never delays a point. Every 10 s, if new points arrived, one batched call to the contributor model confirms or corrects Insight's urgency + kind; the overlay updates the bubble in place. Action items are tagged by the Notes Builder itself (no race with notes.ready). A user re-tag (source: user) always wins.&lt;br&gt;&lt;font color=&quot;#c92a2a&quot;&gt;&lt;i&gt;ring 2 · first ring-2 cut&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;i&gt;Wave 4 · test: FakeLLM canned tags; schema check.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fontSize=10;" vertex="1" parent="L_be"><mxGeometry x="380" y="610" width="300" height="150" as="geometry"/></mxCell><mxCell id="t_cls" value="tags.set { target: &quot;point&quot;|&quot;action&quot;,&#10;  target_id,&#10;  kind?: point|question|decision|pushback,&#10;  urgency?: urgent|medium|later,&#10;  source: &quot;model&quot;|&quot;user&quot;, model? }" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=6;fontSize=9;fontFamily=Courier New;" vertex="1" parent="L_be"><mxGeometry x="760" y="610" width="340" height="120" as="geometry"/></mxCell><mxCell id="p_cls" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="L_be" source="t_cls" target="cls"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="nb" value="&lt;b&gt;Notes Builder&lt;/b&gt;&lt;br&gt;On meeting.ended: full log + roles + live points into the notes template (contributor model, schema enforced). Per person: why they matter, relevant + own points, action items with owner, assigned/suggested and urgency (no separate tagging pass).&lt;br&gt;&lt;font color=&quot;#c92a2a&quot;&gt;&lt;i&gt;✂ 4 per-person depth (keep live points + actions)&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;i&gt;Wave 4 · test: FakeLLM canned notes; validates notes.ready.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fontSize=10;" vertex="1" parent="L_be"><mxGeometry x="380" y="800" width="300" height="150" as="geometry"/></mxCell><mxCell id="t_nb" value="notes.ready&#10;{ meeting_id, project_id?, url,&#10;  people: [{ name, role, why,&#10;   relevant_points[], own_points[],&#10;   actions: [{ action_id, text, owner,&#10;    status: assigned|suggested,&#10;    urgency: urgent|medium|later }] }] }" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=6;fontSize=9;fontFamily=Courier New;" vertex="1" parent="L_be"><mxGeometry x="760" y="800" width="340" height="120" as="geometry"/></mxCell><mxCell id="p_nb" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="L_be" source="t_nb" target="nb"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="es" value="&lt;b&gt;Event Store&lt;/b&gt;&lt;br&gt;Appends every accepted envelope to SQLite (WAL); id UNIQUE is the second dedupe line. FTS5 over final transcript + point text. Meetings indexed by project_id (roadmap: Recall per project). Kept until deleted.&lt;br&gt;&lt;font color=&quot;#c92a2a&quot;&gt;&lt;i&gt;ring 2&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;i&gt;Wave 2 · test: duplicate id → one row.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fontSize=10;" vertex="1" parent="L_be"><mxGeometry x="380" y="990" width="300" height="150" as="geometry"/></mxCell><mxCell id="t_es" value="events (SQLite)&#10;seq PK, id UNIQUE, type, time,&#10;meetingid, source, data JSON&#10;meetings(meetingid, project_id, t0)&#10;+ FTS5(transcript text, point text)" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=6;fontSize=9;fontFamily=Courier New;" vertex="1" parent="L_be"><mxGeometry x="760" y="990" width="340" height="120" as="geometry"/></mxCell><mxCell id="p_es" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="L_be" source="t_es" target="es"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ns" value="&lt;b&gt;Notes Service&lt;/b&gt;&lt;br&gt;Meeting + person pages from SQLite, FTS5 search, Markdown export, links to the transcript line and recording time. Merges tags (user over model); groups actions Urgent / Medium / Later.&lt;br&gt;&lt;font color=&quot;#c92a2a&quot;&gt;&lt;i&gt;ring 2&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;i&gt;Wave 4 · test: HTTP snapshots on a replay-seeded DB.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fontSize=10;" vertex="1" parent="L_be"><mxGeometry x="380" y="1180" width="300" height="150" as="geometry"/></mxCell><mxCell id="t_ns" value="search hit&#10;{ meeting_id, point_id | turn_id,&#10;  snippet, ts_ms }" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=6;fontSize=9;fontFamily=Courier New;" vertex="1" parent="L_be"><mxGeometry x="760" y="1180" width="340" height="120" as="geometry"/></mxCell><mxCell id="p_ns" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="L_be" source="t_ns" target="ns"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="rec" value="&lt;b&gt;Recorder&lt;/b&gt; (converter)&lt;br&gt;webm chunks (tab video + tab audio + your mic) to local files on this PC with a ts_ms index on the meeting clock; finalizes the file on meeting.ended. Kept until you delete them; cloud upload = later option via API.&lt;br&gt;&lt;font color=&quot;#c92a2a&quot;&gt;&lt;i&gt;✂ 3 drop video, keep transcript links&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;i&gt;Wave 4 · test: replayed rec chunks → file + index.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fontSize=10;" vertex="1" parent="L_be"><mxGeometry x="380" y="1370" width="300" height="150" as="geometry"/></mxCell><mxCell id="t_rec" value="recording&#10;{ meeting_id, path, t0_ms,&#10;  ts_ms_index }&#10;kept until deleted" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=6;fontSize=9;fontFamily=Courier New;" vertex="1" parent="L_be"><mxGeometry x="760" y="1370" width="340" height="120" as="geometry"/></mxCell><mxCell id="p_rec" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="L_be" source="t_rec" target="rec"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g_tr" value="DATA: binary audio by stream" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitPerimeter=0;entryPerimeter=0;exitX=1;exitY=0.0507;entryX=0;entryY=0.5;strokeColor=#c92a2a;strokeWidth=3;" edge="1" parent="L_be" source="gw" target="tr"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="g_co" value="tiles.snapshot, speaker.active, meeting.*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitPerimeter=0;entryPerimeter=0;exitX=1;exitY=0.1791;entryX=0;entryY=0.5;strokeColor=#c92a2a;strokeWidth=3;" edge="1" parent="L_be" source="gw" target="co"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="g_ins" value="meeting.context" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitPerimeter=0;entryPerimeter=0;exitX=1;exitY=0.2905;entryX=0;entryY=0.3333;" edge="1" parent="L_be" source="gw" target="ins"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ins_g" value="points.upsert, llm.health" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitPerimeter=0;entryPerimeter=0;exitX=0;exitY=0.6667;entryX=1;entryY=0.3243;strokeColor=#c92a2a;strokeWidth=3;" edge="1" parent="L_be" source="ins" target="gw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="cls_g" value="tags.set (live)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitPerimeter=0;entryPerimeter=0;exitX=0;exitY=0.5;entryX=1;entryY=0.4358;" edge="1" parent="L_be" source="cls" target="gw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="g_es" value="every envelope (bus tap)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitPerimeter=0;entryPerimeter=0;exitX=1;exitY=0.6926;entryX=0;entryY=0.5;" edge="1" parent="L_be" source="gw" target="es"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="g_ns" value="HTTP route" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitPerimeter=0;entryPerimeter=0;exitX=1;exitY=0.8209;entryX=0;entryY=0.5;" edge="1" parent="L_be" source="gw" target="ns"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="g_rec" value="DATA: binary rec chunks" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitPerimeter=0;entryPerimeter=0;exitX=1;exitY=0.9493;entryX=0;entryY=0.5;" edge="1" parent="L_be" source="gw" target="rec"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="tr_co" value="transcript.final" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitPerimeter=0;entryPerimeter=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#c92a2a;strokeWidth=3;" edge="1" parent="L_be" source="tr" target="co"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="co_ins" value="turn.attributed, speaker.mapped (corrects[])" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitPerimeter=0;entryPerimeter=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#c92a2a;strokeWidth=3;" edge="1" parent="L_be" source="co" target="ins"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ins_cls" value="points.upsert (bus)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitPerimeter=0;entryPerimeter=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="L_be" source="ins" target="cls"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="es_nb" value="meeting.ended: read full log" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitPerimeter=0;entryPerimeter=0;exitX=0.3;exitY=0;entryX=0.3;entryY=1;" edge="1" parent="L_be" source="es" target="nb"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="nb_es" value="notes.ready" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitPerimeter=0;entryPerimeter=0;exitX=0.7;exitY=1;entryX=0.7;entryY=0;" edge="1" parent="L_be" source="nb" target="es"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="es_ns" value="SQLite read (FTS5, tags)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitPerimeter=0;entryPerimeter=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="L_be" source="es" target="ns"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rec_ns" value="recording index" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitPerimeter=0;entryPerimeter=0;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="L_be" source="rec" target="ns"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_setup" value="meeting.context ⇄ ACK (via the hub's socket)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitPerimeter=0;entryPerimeter=0;exitX=1;exitY=0.5;entryX=0;entryY=0.0507;" edge="1" parent="1" source="setup" target="gw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_cap" value="DATA plane: binary audio + rec chunks (ts_ms), no envelope, no ACK" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitPerimeter=0;entryPerimeter=0;exitX=1;exitY=0.5;entryX=0;entryY=0.1791;strokeColor=#c92a2a;strokeWidth=3;" edge="1" parent="1" source="cap" target="gw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_adp" value="tiles.snapshot, speaker.active ⇄ ACK,&lt;br&gt;meeting.started/ended (sent by the hub)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitPerimeter=0;entryPerimeter=0;exitX=1;exitY=0.5;entryX=0;entryY=0.3074;strokeColor=#c92a2a;strokeWidth=3;" edge="1" parent="1" source="adp" target="gw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_ovl" value="points.upsert, tags.set, speaker.mapped,&lt;br&gt;system.status, notes.ready ⇄ ACK from Overlay" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitPerimeter=0;entryPerimeter=0;exitX=0;exitY=0.6926;entryX=1;entryY=0.5;strokeColor=#c92a2a;strokeWidth=3;" edge="1" parent="1" source="gw" target="ovl"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="L_api" value="External model APIs (keys only in backend .env, never in CI)" style="swimlane;startSize=30;html=1;fontSize=13;fontStyle=1;fillColor=#fafafa;strokeColor=#999999;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="2820" y="640" width="340" height="1040" as="geometry"/></mxCell><mxCell id="voice" value="&lt;b&gt;Muse Voice Transcribe&lt;/b&gt; (Meta API)&lt;br&gt;wss://api.meta.ai/v1/asr/realtime&lt;br&gt;muse-voice-transcribe-1.0&lt;br&gt;tab session: diarization&lt;br&gt;mic session: endpointing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fontSize=10;strokeColor=#c92a2a;strokeWidth=3;" vertex="1" parent="L_api"><mxGeometry x="20" y="100" width="300" height="140" as="geometry"/></mxCell><mxCell id="sparkopen" value="&lt;b&gt;Spark Open (Baseten) · Insight default&lt;/b&gt;&lt;br&gt;meta-models/muse-spark-open-1026, reasoning_effort low&lt;br&gt;json_schema NOT enforced: validate&lt;br&gt;Open-weights prize entry · basic tier 15 RPM: ask for 120" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fontSize=10;strokeColor=#c92a2a;strokeWidth=3;" vertex="1" parent="L_api"><mxGeometry x="20" y="480" width="300" height="140" as="geometry"/></mxCell><mxCell id="contrib" value="&lt;b&gt;muse-spark-1.3-contributor&lt;/b&gt; (Meta API)&lt;br&gt;api.meta.ai/v1 · json_schema enforced&lt;br&gt;$0.10 in / $0.20 out per 1M tokens, 150 RPM&lt;br&gt;&lt;br&gt;One model for three jobs:&lt;br&gt;· Insight failover (slow or bad JSON)&lt;br&gt;· Classifier: live every 10 s + meeting end&lt;br&gt;· Notes Builder: once per meeting&lt;br&gt;&lt;br&gt;Meta may train on the content. Fine for Halo: open source, demo meetings hold no real data (Karim, 2026-10-30). The consent badge still says so." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fontSize=10;" vertex="1" parent="L_api"><mxGeometry x="20" y="670" width="300" height="330" as="geometry"/></mxCell><mxCell id="tr_voice" value="paced PCM → turns (realtime WS)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitPerimeter=0;entryPerimeter=0;exitX=1;exitY=0.97;entryX=0;entryY=0.607;strokeColor=#c92a2a;strokeWidth=3;" edge="1" parent="1" source="tr" target="voice"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ins_open" value="chat.completions, json_schema" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitPerimeter=0;entryPerimeter=0;exitX=1;exitY=0.97;entryX=0;entryY=0.607;strokeColor=#c92a2a;strokeWidth=3;" edge="1" parent="1" source="ins" target="sparkopen"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="cls_c" value="batched tags (10 s + end)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitPerimeter=0;entryPerimeter=0;exitX=1;exitY=0.97;entryX=0;entryY=0.2576;" edge="1" parent="1" source="cls" target="contrib"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="nb_13" value="notes template" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitPerimeter=0;entryPerimeter=0;exitX=1;exitY=0.97;entryX=0;entryY=0.8333;" edge="1" parent="1" source="nb" target="contrib"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="fail" value="per call: &amp;gt;4 s, bad JSON&lt;br&gt;twice or 429; back to&lt;br&gt;Spark Open after 30 s" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitPerimeter=0;entryPerimeter=0;exitX=1;exitY=0.5;entryX=1;entryY=0.15;dashed=1;" edge="1" parent="L_api" source="sparkopen" target="contrib"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="332" y="550"/><mxPoint x="332" y="720"/></Array></mxGeometry></mxCell><mxCell id="L_fake" value="Fake engines (Wave 1)" style="swimlane;startSize=30;html=1;fontSize=13;fontStyle=1;fillColor=#f7f1fa;strokeColor=#9673a6;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="2820" y="1720" width="340" height="330" as="geometry"/></mxCell><mxCell id="fasr" value="&lt;b&gt;FakeASR&lt;/b&gt;&lt;br&gt;Speaks the Voice realtime WS protocol. Emits the fixture's scripted turns at offsets matching the audio it gets. Knobs: latency, forced session drop, AR/EN code-switch." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fontSize=10;" vertex="1" parent="L_fake"><mxGeometry x="20" y="40" width="300" height="130" as="geometry"/></mxCell><mxCell id="fllm" value="&lt;b&gt;FakeLLM&lt;/b&gt;&lt;br&gt;OpenAI-compatible /v1/chat/completions; stands in for Spark Open and Spark 1.3 contributor. Canned JSON per fixture turn. Knobs: latency spread (forces &amp;gt;4 s failover), invalid-JSON rate (forces retry)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fontSize=10;" vertex="1" parent="L_fake"><mxGeometry x="20" y="185" width="300" height="130" as="geometry"/></mxCell><mxCell id="f_api" value="drop-in: same wire protocol&lt;br&gt;(HALO_ENGINES=fake, per engine)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitPerimeter=0;entryPerimeter=0;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="L_fake" target="L_api"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="stretch" value="&lt;b&gt;Stretch only · SAM 3.1 Face Refiner&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#c92a2a&quot;&gt;&lt;i&gt;✂ 1: first to cut. Not in the MVP.&lt;/i&gt;&lt;/font&gt;&lt;br&gt;If time allows: SAM 3.1 masks for a &quot;name tucks behind the head&quot; effect. Plugs in as another faces.update engine (engine: &quot;sam&quot;), so nothing else changes. Runs on the local 3080 Ti, or Modal ($30, optional, never leave a GPU warm). Would be the only thing that ever sends a frame off the tab." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fontSize=10;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="2820" y="2090" width="340" height="210" as="geometry"/></mxCell><mxCell id="questions" value="&lt;b&gt;Decided with Karim (2026-10-30)&lt;/b&gt;&lt;br&gt;· Test rig: lean, built in parallel. CI golden = a committed synthetic fixture; recorded calls stay local.&lt;br&gt;· Urgency: Insight's first guess live + Classifier every 10 s (first ring-2 cut); the Notes Builder tags action items.&lt;br&gt;· Every Spark 1.3 call uses the contributor model; Insight fails over per call and returns to Spark Open after 30 s.&lt;br&gt;· ACK on the socket only (saves ~8-10 agent-hours).&lt;br&gt;· Path B cut: no &amp;lt;video&amp;gt; → Frame mode.&lt;br&gt;· PRs merge on green CI; Claude reviews contracts + critical path.&lt;br&gt;· Pairing: Origin (pinned key) + one-time code. MIT. Recordings local, kept until deleted. Headset required. No X post.&lt;br&gt;&lt;br&gt;&lt;b&gt;Engineering defaults&lt;/b&gt;&lt;br&gt;· MediaPipe, bundled; Worker in a hidden extension iframe.&lt;br&gt;· The hub (offscreen doc) holds the socket and mints meeting_id at Start.&lt;br&gt;· Overlay DOM via textContent (Trusted Types); mirrored self tile.&lt;br&gt;&lt;br&gt;&lt;b&gt;Still open&lt;/b&gt;&lt;br&gt;1. Karim runs the 3 day-0 probes: meet-overlay, spark-latency, arabic-asr.&lt;br&gt;2. Urgency-mark look: drafts first." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="3220" y="640" width="520" height="560" as="geometry"/></mxCell><mxCell id="changes" value="&lt;b&gt;Fixes from the independent review (2026-10-30 night)&lt;/b&gt;&lt;br&gt;1. Insight now receives turn.attributed (text + who) from the Correlator; before, it got no transcript at all.&lt;br&gt;2. Waves vs windows: waves are 'Wave n', windows are W1-W3; owners live in DECISIONS section 6.&lt;br&gt;3. Test gates CI can actually run: synthetic golden, ?halo_test=1 hub hook, CC0 photo faces.&lt;br&gt;4. ACK on the socket only; chaos kit and AsyncAPI cut.&lt;br&gt;5. meeting_id minted by the hub at Start; meeting.ended after a 60 s grace.&lt;br&gt;6. Per-call failover with return to Spark Open (keeps the open-weights entry honest).&lt;br&gt;7. Notes Builder tags action urgency itself: no race with notes.ready.&lt;br&gt;8. Contracts: Adapter → Overlay tile data, one kind vocabulary, pair.hello from the hub, a tags.set edge, finals only, transcriber.rotated cut.&lt;br&gt;9. Path B cut (a video track can't cross from the capture page to Meet's page).&lt;br&gt;10. Meet realities: Trusted Types, mirrored self tile, highlight-lag knob, Host-header check, pinned extension key, your mic in the recording." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="3220" y="1230" width="520" height="600" as="geometry"/></mxCell><mxCell id="L_fmeet" value="Fake Meet page (Wave 1)" style="swimlane;startSize=30;html=1;fontSize=13;fontStyle=1;fillColor=#f7f1fa;strokeColor=#9673a6;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="780" y="1850" width="700" height="290" as="geometry"/></mxCell><mxCell id="pw" value="&lt;b&gt;Playwright harness&lt;/b&gt;&lt;br&gt;Loads the unpacked extension into Chromium, opens the Fake Meet page, points the extension at Replayer mode B. Asserts overlay DOM positions against the painted ground truth (±4 px), Face Detector IoU on CC0 photo faces, dev build opening the hub via ?halo_test=1, screenshot diffs, and the envelopes + binary the extension sends. Runs in CI as L3, no keys." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fontSize=10;" vertex="1" parent="L_fmeet"><mxGeometry x="20" y="40" width="300" height="220" as="geometry"/></mxCell><mxCell id="fmeet" value="&lt;b&gt;Fake Meet page&lt;/b&gt;&lt;br&gt;Static page copying Meet's DOM anchors (data-participant-id, name spans, self tile, speaking-highlight toggles). Tiles play fixture video or CC0 photo faces via canvas MediaStreams, object-fit cover at mismatched aspect ratios. Modes: video | canvas-only (no &amp;lt;video&amp;gt;, forces Frame mode). Serves Meet's CSP + Trusted Types headers. Scripted layouts, join/leave, screen share. Grows from rig/fake_meet/seed-fixture.html (the day-0 probe page)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fontSize=10;" vertex="1" parent="L_fmeet"><mxGeometry x="360" y="40" width="300" height="220" as="geometry"/></mxCell><mxCell id="pw_fm" value="drives" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitPerimeter=0;entryPerimeter=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="L_fmeet" source="pw" target="fmeet"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="fm_ext" value="hosts the real content scripts" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitPerimeter=0;entryPerimeter=0;exitX=0.5;exitY=0;entryX=0.7286;entryY=1;" edge="1" parent="1" source="fmeet" target="L_ext"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="L_rep" value="Replay rig (Wave 1)" style="swimlane;startSize=30;html=1;fontSize=13;fontStyle=1;fillColor=#f7f1fa;strokeColor=#9673a6;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1620" y="2240" width="700" height="500" as="geometry"/></mxCell><mxCell id="rp" value="&lt;b&gt;Replayer&lt;/b&gt;&lt;br&gt;Mode A (fake extension): pairs with a test token, sends meeting.started, envelopes and binary audio + rec chunks at their recorded ts_ms (1× real time, or fast on a virtual clock), honours ACK + resend.&lt;br&gt;Mode B (fake backend): replays recorded backend → extension events to the extension on the Fake Meet page.&lt;br&gt;Chaos knobs from the contract kit." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fontSize=10;" vertex="1" parent="L_rep"><mxGeometry x="40" y="50" width="290" height="210" as="geometry"/></mxCell><mxCell id="chk" value="&lt;b&gt;Golden asserts&lt;/b&gt; (plain tests)&lt;br&gt;CI: a committed synthetic fixture; a run (events.sqlite + what the Replayer received) must match expected.jsonl: ts ±300 ms, fuzzy text, ids ignored, order per tile. Local L4: Karim's recorded calls, one real run frozen + spot-checked, never committed." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fontSize=10;" vertex="1" parent="L_rep"><mxGeometry x="390" y="50" width="290" height="210" as="geometry"/></mxCell><mxCell id="fcap" value="&lt;b&gt;Fixture Capture&lt;/b&gt;&lt;br&gt;Oct 31: Karim records 2-3 calls with OBS (screen + separate desktop and mic tracks), converted to fixtures locally. Later: a record mode in the hub. The synthetic fixture is generated in Wave 1." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fontSize=10;" vertex="1" parent="L_rep"><mxGeometry x="40" y="300" width="290" height="170" as="geometry"/></mxCell><mxCell id="t_fix" value="fixtures/&lt;name&gt;/&#10;  meta.json (tiles, roles, t0_ms)&#10;  tab.pcm  mic.pcm  rec.webm&#10;  envelopes.jsonl (ts_ms)&#10;  frames/&lt;tile&gt;/&lt;ts_ms&gt;.jpg&#10;  asr_script.jsonl -&gt; FakeASR&#10;  llm_script.jsonl -&gt; FakeLLM&#10;  faces.jsonl -&gt; detector IoU truth&#10;  expected.jsonl   -&gt; checker" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=6;fontSize=9;fontFamily=Courier New;" vertex="1" parent="L_rep"><mxGeometry x="390" y="300" width="290" height="170" as="geometry"/></mxCell><mxCell id="p_fcap" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="L_rep" source="t_fix" target="fcap"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="rp_chk" value="results" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitPerimeter=0;entryPerimeter=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="L_rep" source="rp" target="chk"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="fcap_rp" value="fixtures/" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitPerimeter=0;entryPerimeter=0;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="L_rep" source="fcap" target="rp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rp_gw" value="mode A: plays the extension ⇄ ACK" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitPerimeter=0;entryPerimeter=0;exitX=0.2759;exitY=0;entryX=0.3333;entryY=1;" edge="1" parent="1" source="rp" target="gw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rp_fm" value="mode B: plays the backend&lt;br&gt;to the extension ⇄ ACK" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitPerimeter=0;entryPerimeter=0;exitX=0;exitY=0.2857;entryX=1;entryY=0.7273;" edge="1" parent="1" source="rp" target="fmeet"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>