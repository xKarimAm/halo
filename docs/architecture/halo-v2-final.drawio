<mxfile host="Claude" version="24.0.0"><diagram id="halo-v2-final" name="Halo v2 final"><mxGraphModel dx="2400" dy="1800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0" adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Halo v2 · FINAL architecture&lt;/b&gt; (2026-10-30, for Karim's review; then the XML goes to Muse for PLAN.md). Base = draft 4 Test-first + draft 2 browser face detector (MAIN face path, frames never leave the browser) + draft 3 tab-capture frames (FALLBACK only) + draft 5 data-plane / control-plane rule. Box = what the module does (italic line = wave + offline test). Arrow = contract (⇄ ACK = acknowledged envelope). Grey mono box = JSON type, plain dashed line to the module that emits it. &lt;font color=&quot;#c92a2a&quot;&gt;&lt;b&gt;Thick red = critical path.&lt;/b&gt;&lt;/font&gt;" style="text;html=1;fontSize=14;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="6" width="3700" height="48" as="geometry"/></mxCell><mxCell id="L_wave" value="Build waves: contracts first, then the test rig, then modules. Arrow = unblocks. A wave merges only when its offline tests are green in CI." style="swimlane;startSize=30;html=1;fontSize=13;fontStyle=1;fillColor=#f7f1fa;strokeColor=#9673a6;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="3700" height="300" as="geometry"/></mxCell><mxCell id="w0" value="&lt;b&gt;Wave 0 · /contracts · Oct 31 morning (W1 only)&lt;/b&gt;&lt;br&gt;Envelope + ACK rules, the two-plane rule, event catalog (AsyncAPI + JSON Schema), clock + coordinate rules, MeetingAdapter interface, codegen (TS + pydantic), a golden sample per type, the contract test kit (chaos, exactly-once, boundary check).&lt;br&gt;&lt;br&gt;&lt;i&gt;Done = every golden sample validates, codegen output committed, boundary check runs in CI.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fontSize=10;" vertex="1" parent="L_wave"><mxGeometry x="30" y="50" width="460" height="220" as="geometry"/></mxCell><mxCell id="w1" value="&lt;b&gt;Wave 1 · LEAN test rig · Oct 31-Nov 1 (W3)&lt;/b&gt;&lt;br&gt;Fake Meet page (grows from day0 fixture.html; video + canvas-only modes) + Playwright, FakeASR, FakeLLM (Spark Open + Spark 1.3 contributor), Replayer (mode A fake extension, mode B fake backend), Fixture Capture. Checks = plain test asserts against one frozen real-engine run that Karim spot-checks.&lt;br&gt;Fixtures: Karim records 2-3 bilingual calls.&lt;br&gt;Until the rig lands, modules test against /contracts golden samples.&lt;br&gt;&lt;i&gt;Done = one fixture replays through the Gateway and the asserts pass.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fontSize=10;" vertex="1" parent="L_wave"><mxGeometry x="550" y="50" width="560" height="220" as="geometry"/></mxCell><mxCell id="w2" value="&lt;b&gt;Wave 2 · Backend critical path · Oct 31-Nov 1 (W1)&lt;/b&gt;&lt;br&gt;Gateway (pairing, ACK, dedupe, system.status), EventBus, Event Store, Transcriber, Correlator, Insight.&lt;br&gt;&lt;i&gt;Done = replay golden (L2) green with the fakes.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fontSize=10;" vertex="1" parent="L_wave"><mxGeometry x="1170" y="40" width="600" height="120" as="geometry"/></mxCell><mxCell id="w3" value="&lt;b&gt;Wave 3 · Extension critical path · Oct 31-Nov 1 (W2)&lt;/b&gt;&lt;br&gt;Setup Panel + pairing + consent, Capture, Meet Adapter (MeetingAdapter), Frame Source (path A; path B fallback), Face Detector, Overlay.&lt;br&gt;&lt;i&gt;Done = Playwright on the Fake Meet page (L3) green.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fontSize=10;" vertex="1" parent="L_wave"><mxGeometry x="1170" y="170" width="600" height="120" as="geometry"/></mxCell><mxCell id="w4" value="&lt;b&gt;Wave 4 · Integrate · Nov 1 night → Nov 2&lt;/b&gt;&lt;br&gt;Nov 1 night: THIN end-to-end on the Replay rig (audio → transcript → point → bubble, Frame mode).&lt;br&gt;Nov 2: Face mode + live Meet; second ring: Classifier, Notes Builder, Notes Service, Notes page, Recorder.&lt;br&gt;&lt;br&gt;&lt;i&gt;Done = full replay golden incl. notes.ready + tags.set, plus Notes page HTTP snapshot tests.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fontSize=10;" vertex="1" parent="L_wave"><mxGeometry x="1830" y="50" width="520" height="220" as="geometry"/></mxCell><mxCell id="w5" value="&lt;b&gt;Wave 5 · Ship · Nov 2 night → submit Nov 3&lt;/b&gt;&lt;br&gt;Nov 2 night: live Meet rehearsal (L5), cut list applied to anything not solid. Packaging: README install steps + one command (&lt;i&gt;halo&lt;/i&gt;) that starts the backend and prints the pairing code.&lt;br&gt;Nov 3: record the 3-min demo video, submit (public repo + video).&lt;br&gt;&lt;i&gt;Done = submitted.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fontSize=10;" vertex="1" parent="L_wave"><mxGeometry x="2410" y="50" width="480" height="220" as="geometry"/></mxCell><mxCell id="ladder" value="&lt;b&gt;Test ladder: what runs where&lt;/b&gt;&lt;br&gt;&lt;font face='Courier New'&gt;L0 contract: schemas + golden samples ...... every PR, $0&lt;br&gt;L1 module unit tests with fakes ............ every PR, $0&lt;br&gt;L2 replay golden, backend (Replayer A) ..... every PR, $0&lt;br&gt;L3 Playwright on Fake Meet (Replayer B) .... every PR, $0&lt;br&gt;L4 real-engine smoke on one fixture ...... on demand, capped&lt;br&gt;L5 live Meet rehearsal ................. before demo, Karim&lt;/font&gt;&lt;br&gt;&lt;br&gt;CI runs L0-L3 only: no keys, no GPU, no network. The Face Detector runs inside L3 on the Fake Meet's synthetic faces (IoU vs painted truth)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fontSize=10;" vertex="1" parent="L_wave"><mxGeometry x="2950" y="40" width="720" height="245" as="geometry"/></mxCell><mxCell id="s01" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitPerimeter=0;entryPerimeter=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="L_wave" source="w0" target="w1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitPerimeter=0;entryPerimeter=0;exitX=1;exitY=0.2273;entryX=0;entryY=0.5;" edge="1" parent="L_wave" source="w1" target="w2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitPerimeter=0;entryPerimeter=0;exitX=1;exitY=0.8182;entryX=0;entryY=0.5;" edge="1" parent="L_wave" source="w1" target="w3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitPerimeter=0;entryPerimeter=0;exitX=1;exitY=0.5;entryX=0;entryY=0.2273;" edge="1" parent="L_wave" source="w2" target="w4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitPerimeter=0;entryPerimeter=0;exitX=1;exitY=0.5;entryX=0;entryY=0.8182;" edge="1" parent="L_wave" source="w3" target="w4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s45" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitPerimeter=0;entryPerimeter=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="L_wave" source="w4" target="w5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="legend" value="&lt;b&gt;Key&lt;/b&gt;&lt;br&gt;Box = what the module does; italic line = the wave that builds it + its offline test. Arrow = contract on the label; ⇄ ACK = acknowledged envelope (ACK = accepted on the bus, not processed). Grey mono box = JSON type, plain dashed line to its module.&lt;br&gt;&lt;b&gt;Data plane&lt;/b&gt; (binary audio + rec chunks): no envelope, no ACK. &lt;b&gt;Control plane&lt;/b&gt;: envelopes ⇄ ACK. Green dashed arrow = in-tab call, never on the wire.&lt;br&gt;&lt;br&gt;Colours: green = extension · blue = backend · red = paid model API · purple = test tooling (never shipped) · white = /contracts · yellow = notes for Karim. &lt;font color=&quot;#c92a2a&quot;&gt;&lt;b&gt;Thick red border/arrow = critical path&lt;/b&gt;&lt;/font&gt;; &lt;font color=&quot;#c92a2a&quot;&gt;&lt;i&gt;✂ n&lt;/i&gt;&lt;/font&gt; = cut line n; &lt;i&gt;ring 2&lt;/i&gt; = second ring.&lt;br&gt;Inside the backend every arrow is an EventBus topic; the Event Store taps all of them. One meeting clock (browser ts_ms)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="700" height="220" as="geometry"/></mxCell><mxCell id="L_notes" value="Browser tab: Notes page (served by the backend) · ring 2" style="swimlane;startSize=30;html=1;fontSize=13;fontStyle=1;fillColor=#fafafa;strokeColor=#999999;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="780" y="400" width="700" height="200" as="geometry"/></mxCell><mxCell id="notespage" value="&lt;b&gt;Notes page&lt;/b&gt;&lt;br&gt;Build from &lt;i&gt;docs/ui/notes-v2.html?palette=2&lt;/i&gt; (People First, Sage &amp;amp; Clay). Meeting list + search; per person: role, relevant points, own points, action items grouped Urgent / Medium / Later. Points link to transcript line + recording moment. One-click re-tag.&lt;br&gt;&lt;font color=&quot;#c92a2a&quot;&gt;&lt;i&gt;✂ 5 re-tag menu · ✂ 6 Arabic polish beyond RTL&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;i&gt;W4 · test: HTTP snapshots on a replay-seeded DB.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fontSize=10;" vertex="1" parent="L_notes"><mxGeometry x="360" y="35" width="300" height="150" as="geometry"/></mxCell><mxCell id="t_http" value="HTTP (JSON, no envelope)&#10;GET  /notes/{meeting_id} -&gt; HTML&#10;GET  /api/meetings?project_id=&#10;GET  /api/search?q=&#10;GET  /api/meetings/{id}/export.md&#10;POST /api/tags { target_id,&#10;  category?, urgency? }&#10;GET /pair  POST /pair {code}-&gt;{token}" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=6;fontSize=9;fontFamily=Courier New;" vertex="1" parent="L_notes"><mxGeometry x="20" y="35" width="300" height="150" as="geometry"/></mxCell><mxCell id="p_notespage" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="L_notes" source="t_http" target="notespage"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="crit" value="&lt;b&gt;&lt;font color=&quot;#c92a2a&quot;&gt;Critical path&lt;/font&gt; (DECISIONS §8: the demo dies if any link fails)&lt;/b&gt;&lt;br&gt;Tab + Mic Capture → Gateway → Transcriber → Correlator → Insight → Gateway → Overlay, plus Meet Adapter (tiles, names, speaking highlight) → Frame Source → Face Detector → Overlay. Integrate and demo this chain end to end FIRST on the Replay rig, then live.&lt;br&gt;&lt;b&gt;Second ring:&lt;/b&gt; Event Store, Notes Service + Notes page, Setup Panel, Classifier.&lt;br&gt;&lt;b&gt;Cut lines, in this order if time runs out:&lt;/b&gt; ✂1 SAM 3.1 stretch · ✂2 Zoom/Teams adapters · ✂3 Recorder (keep transcript links, drop video) · ✂4 Notes Builder per-person depth (keep live points + action list) · ✂5 re-tag menu · ✂6 Arabic UI polish beyond RTL correctness.&lt;br&gt;&lt;b&gt;Never cut:&lt;/b&gt; consent badge, the critical path, contract validation.&lt;br&gt;&lt;b&gt;Rules:&lt;/b&gt; everyone in a Halo call wears a headset (echo). Crosstalk: a turn with two speakers is marked overlap; the demo script avoids it. &lt;b&gt;Deadline: submit Nov 3.&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff5f5;strokeColor=#c92a2a;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2820" y="400" width="920" height="220" as="geometry"/></mxCell><mxCell id="e_http" value="HTTP GET /notes, /api/*, /pair · POST /api/tags" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitPerimeter=0;entryPerimeter=0;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="notespage" target="gw"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1780" y="510"/></Array></mxGeometry></mxCell><mxCell id="L_con" value="/contracts (Wave 0): the only thing modules share · codegen → TS types (extension) + pydantic (backend)" style="swimlane;startSize=30;html=1;fontSize=13;fontStyle=1;fillColor=#fafafa;strokeColor=#999999;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="700" height="1360" as="geometry"/></mxCell><mxCell id="c_ack" value="&lt;b&gt;Envelope + ACK rules&lt;/b&gt;&lt;br&gt;Every control-plane JSON message is a CloudEvents 1.0 envelope.&lt;br&gt;&lt;b&gt;ACK = accepted on the bus&lt;/b&gt;: validated against the schema, deduped, published (the Event Store persists it). It does NOT mean processed.&lt;br&gt;Sender keeps an outbox: no ACK in 2 s → resend the SAME id (3 tries, then system.status degraded).&lt;br&gt;Every receiver dedupes by id (seen-id set; Event Store id UNIQUE). A duplicate is re-ACKed ok and dropped.&lt;br&gt;Model outputs are always schema-validated (Spark Open does not enforce json_schema)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fontSize=10;" vertex="1" parent="L_con"><mxGeometry x="20" y="40" width="320" height="230" as="geometry"/></mxCell><mxCell id="t_env" value="envelope (CloudEvents 1.0)&#10;{ specversion: &quot;1.0&quot;, id, type,&#10;  source, time, meetingid,&#10;  datacontenttype:&#10;    &quot;application/json&quot;,&#10;  data: {...} }&#10;&#10;ACK&#10;{ ack_of: id,&#10;  status: &quot;ok&quot;|&quot;error&quot;,&#10;  error?: { code, message } }&#10;duplicate id -&gt; ACK ok again,&#10;  do not re-apply" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=6;fontSize=9;fontFamily=Courier New;" vertex="1" parent="L_con"><mxGeometry x="360" y="40" width="320" height="230" as="geometry"/></mxCell><mxCell id="p_c_ack" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="L_con" source="t_env" target="c_ack"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c_plane" value="&lt;b&gt;Two planes (from draft 5)&lt;/b&gt;&lt;br&gt;&lt;b&gt;Data plane&lt;/b&gt; = binary on the one WebSocket: audio + recording chunks. No envelope, no ACK, no retry, no id. Audio is lossless + ordered (backpressure, not drops). Face frames never cross the wire; the only video sent is the local recording (rec chunks).&lt;br&gt;&lt;b&gt;Control plane&lt;/b&gt; = envelopes ⇄ ACK only: lifecycle, context, transcripts, points, tags, status, pairing.&lt;br&gt;&lt;b&gt;Converters&lt;/b&gt; are the only bridge (binary in, envelopes out): Transcriber, Recorder." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fontSize=10;" vertex="1" parent="L_con"><mxGeometry x="20" y="300" width="320" height="230" as="geometry"/></mxCell><mxCell id="t_plane" value="data-plane rules (Gateway data side)&#10;audio kind=1: lossless, ordered FIFO&#10;  per stream; seq gap -&gt; silence&#10;  pad + gap logged; bound 30 s,&#10;  then system.status warn&#10;rec   kind=3: lossless append;&#10;  disk lag -&gt; spill to temp&#10;video: NOT on the wire (in-tab only)&#10;never: ACKs, retries, ids on binary&#10;&#10;control plane: envelopes only,&#10;  ACK, resend same id, dedupe" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=6;fontSize=9;fontFamily=Courier New;" vertex="1" parent="L_con"><mxGeometry x="360" y="300" width="320" height="230" as="geometry"/></mxCell><mxCell id="p_c_plane" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="L_con" source="t_plane" target="c_plane"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c_cat" value="&lt;b&gt;Event catalog&lt;/b&gt;&lt;br&gt;AsyncAPI, 2 channels: extension ⇄ Gateway (one WS: binary + envelopes) and the in-process bus topics. In-tab messages (TileFrame, faces.update) are typed in /contracts too, but never sent.&lt;br&gt;Future-proofing, added now: &lt;b&gt;project_id&lt;/b&gt; (optional) on meeting.context; &lt;b&gt;platform&lt;/b&gt; on meeting.started (MeetingAdapter); faces.update is &lt;b&gt;engine-agnostic&lt;/b&gt;; tags.set for the Classifier." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fontSize=10;" vertex="1" parent="L_con"><mxGeometry x="20" y="560" width="320" height="240" as="geometry"/></mxCell><mxCell id="t_cat" value="pair.hello { token, ext_version }&#10;pair.ok { session_id } | pair.rejected&#10;meeting.started { platform:&#10;  &quot;meet&quot;|&quot;zoom&quot;|&quot;teams&quot;,&#10;  meeting_code, t0_ms, self_name }&#10;meeting.ended { reason: left|&#10;  tab_closed|timeout }&#10;  (Gateway synthesizes on dead WS)&#10;system.status {&#10;  asr: ok|reconnecting|down,&#10;  llm: { engine, failover: bool },&#10;  tagger: ok|down,&#10;  outbox_backlog }" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=6;fontSize=9;fontFamily=Courier New;" vertex="1" parent="L_con"><mxGeometry x="360" y="560" width="320" height="240" as="geometry"/></mxCell><mxCell id="p_c_cat" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="L_con" source="t_cat" target="c_cat"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c_clk" value="&lt;b&gt;Clock + coordinate rules&lt;/b&gt;&lt;br&gt;&lt;b&gt;One meeting clock&lt;/b&gt;: browser epoch ms (performance.timeOrigin + now), stamped once at the source in the extension. t0 = meeting.started.t0_ms. The backend never re-stamps meeting time; envelope.time is server wall clock, for logs only.&lt;br&gt;&lt;b&gt;Boxes&lt;/b&gt; are 0..1 of the SOURCE FRAME (frame_w × frame_h: the tile video in path A, the tile crop in path B). Only the Overlay converts to screen, with tile rect + video size + object-fit." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fontSize=10;" vertex="1" parent="L_con"><mxGeometry x="20" y="830" width="320" height="240" as="geometry"/></mxCell><mxCell id="t_clk" value="ts_ms: u64, browser epoch ms&#10;t_rel = ts_ms - t0_ms&#10;&#10;ASR turn time:&#10;  ts = anchor_ts + asr_offset&#10;  (Transcriber keeps seq -&gt; ts_ms&#10;   of the frames it paced, pads incl.)&#10;&#10;box space &quot;source&quot;:&#10;  { frame_w, frame_h,&#10;    box: [x,y,w,h] in 0..1 }&#10;screen = project(box, tile_rect,&#10;  video_w, video_h, object_fit)" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=6;fontSize=9;fontFamily=Courier New;" vertex="1" parent="L_con"><mxGeometry x="360" y="830" width="320" height="240" as="geometry"/></mxCell><mxCell id="p_c_clk" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="L_con" source="t_clk" target="c_clk"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c_kit" value="&lt;b&gt;Codegen + contract test kit&lt;/b&gt;&lt;br&gt;JSON Schema → TS types (extension) and pydantic models (backend). A golden sample per type.&lt;br&gt;Kit: chaos (drop ACK, duplicate, reorder, delay), exactly-once check on events.sqlite, clock checks, module-boundary check (a module imports only /contracts + the bus)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fontSize=10;" vertex="1" parent="L_con"><mxGeometry x="20" y="1100" width="320" height="220" as="geometry"/></mxCell><mxCell id="t_kit" value="chaos(drop_ack=0.05,&#10;      duplicate=0.05,&#10;      reorder=0.02,&#10;      delay_ms=[0, 500])&#10;assert_exactly_once(events.sqlite)&#10;assert_monotonic(ts_ms)&#10;check_boundaries(module)" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=6;fontSize=9;fontFamily=Courier New;" vertex="1" parent="L_con"><mxGeometry x="360" y="1100" width="320" height="160" as="geometry"/></mxCell><mxCell id="p_c_kit" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="L_con" source="t_kit" target="c_kit"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="L_ext" value="Chrome extension (WXT/TS, no keys). ONE WebSocket, held by the offscreen doc (alive for the whole capture); Setup Panel, Meet Adapter + Overlay reach it over a chrome.runtime Port" style="swimlane;startSize=30;html=1;fontSize=13;fontStyle=1;fillColor=#fafafa;strokeColor=#999999;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="780" y="640" width="700" height="1170" as="geometry"/></mxCell><mxCell id="setup" value="&lt;b&gt;Setup Panel + pairing + consent&lt;/b&gt;&lt;br&gt;Pair once: type the 6-digit code from 127.0.0.1/pair; token kept in chrome.storage.local. Every WS opens with pair.hello. Lives in the toolbar popup: its Start click is the user gesture Chrome needs for tabCapture. Subject, agenda, roles, viewer language, optional project → meeting.context. Posts the Meet chat consent notice (incl. &quot;content may train Meta models&quot;) + shows the badge (never cut).&lt;br&gt;&lt;font color=&quot;#c92a2a&quot;&gt;&lt;i&gt;ring 2 (consent badge: never cut)&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;i&gt;W3 · test: Playwright + Replayer B.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fontSize=10;" vertex="1" parent="L_ext"><mxGeometry x="360" y="40" width="300" height="150" as="geometry"/></mxCell><mxCell id="t_setup" value="pair.hello { token, ext_version }&#10;meeting.context&#10;{ subject, agenda,&#10;  roles: [{ name, role }],&#10;  viewer_lang: &quot;en&quot;|&quot;ar&quot;,&#10;  project_id?: string }" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=6;fontSize=9;fontFamily=Courier New;" vertex="1" parent="L_ext"><mxGeometry x="20" y="40" width="300" height="120" as="geometry"/></mxCell><mxCell id="p_setup" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="L_ext" source="t_setup" target="setup"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cap" value="&lt;b&gt;Tab + Mic Capture + WS hub&lt;/b&gt; (offscreen doc)&lt;br&gt;Holds the one WebSocket + the envelope outbox; relays Port messages to and from the Meet-page modules. tabCapture id from the popup click (others) + mic (you; headset required). Replays tab audio so you still hear the call. 16 kHz PCM16, 100 ms frames stamped ts_ms. webm chunks for the Recorder. Lends the tab video track to Frame Source only for path B.&lt;br&gt;&lt;i&gt;W3 · test: fake page audio → ts gap-free.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fontSize=10;strokeColor=#c92a2a;strokeWidth=3;" vertex="1" parent="L_ext"><mxGeometry x="360" y="230" width="300" height="150" as="geometry"/></mxCell><mxCell id="t_cap" value="binary audio (data plane)&#10;[kind=1][stream: tab|mic]&#10;[seq u32][ts_ms u64]&#10;+ PCM16 mono 16 kHz, 100 ms&#10;binary rec chunk (data plane)&#10;[kind=3][seq u32][ts_ms u64]&#10;+ webm" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=6;fontSize=9;fontFamily=Courier New;" vertex="1" parent="L_ext"><mxGeometry x="20" y="230" width="300" height="120" as="geometry"/></mxCell><mxCell id="p_cap" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="L_ext" source="t_cap" target="cap"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="adp" value="&lt;b&gt;Meet Adapter&lt;/b&gt; (implements MeetingAdapter)&lt;br&gt;The only module that knows Meet's DOM (data-participant-id, never class names): tiles, names, self, speaking highlight, tile rect, video element, object-fit. meeting.started on join, meeting.ended on leave or tab close.&lt;br&gt;&lt;font color=&quot;#c92a2a&quot;&gt;&lt;i&gt;✂ 2 Zoom/Teams adapters (roadmap)&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;i&gt;W3 · test: Fake Meet layouts, join/leave, share.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fontSize=10;strokeColor=#c92a2a;strokeWidth=3;" vertex="1" parent="L_ext"><mxGeometry x="360" y="420" width="300" height="150" as="geometry"/></mxCell><mxCell id="t_adp" value="interface MeetingAdapter {&#10;  platform: &quot;meet&quot;|&quot;zoom&quot;|&quot;teams&quot;&#10;  matches(url): bool&#10;  tiles(): Tile[]  // id, name, is_self,&#10;    rect, video?: HTMLVideoElement,&#10;    video_w, video_h, fit&#10;  onTiles(cb) onSpeaking(cb)&#10;  onJoin(cb)  onLeave(cb) }&#10;tiles.snapshot { tiles: [...] }&#10;speaker.active {tile_id,speaking,ts_ms}" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=6;fontSize=9;fontFamily=Courier New;" vertex="1" parent="L_ext"><mxGeometry x="20" y="420" width="300" height="150" as="geometry"/></mxCell><mxCell id="p_adp" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="L_ext" source="t_adp" target="adp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="frm" value="&lt;b&gt;Frame Source&lt;/b&gt; (in-tab only)&lt;br&gt;&lt;b&gt;Path A (main):&lt;/b&gt; draw each tile's &amp;lt;video&amp;gt; to an OffscreenCanvas. &lt;b&gt;Path B (fallback only, from draft 3):&lt;/b&gt; if Meet exposes no &amp;lt;video&amp;gt;, crop the tab video track by tile rect × devicePixelRatio, painting our own name + bubble rects out first. ~10 fps, ≤ 6 tiles. &lt;b&gt;Frames never leave the browser.&lt;/b&gt;&lt;br&gt;&lt;i&gt;Day-0 meet-overlay probe picks A or B · W3 · test: both Fake Meet modes.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fontSize=10;strokeColor=#c92a2a;strokeWidth=3;" vertex="1" parent="L_ext"><mxGeometry x="360" y="610" width="300" height="150" as="geometry"/></mxCell><mxCell id="t_frm" value="TileFrame (in-tab, never sent)&#10;{ tile_id, ts_ms,&#10;  path: &quot;A&quot;|&quot;B&quot;,&#10;  bitmap: ImageBitmap,&#10;  frame_w, frame_h }&#10;(frame_w/h = the space&#10; faces.update boxes use)" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=6;fontSize=9;fontFamily=Courier New;" vertex="1" parent="L_ext"><mxGeometry x="20" y="610" width="300" height="120" as="geometry"/></mxCell><mxCell id="p_frm" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="L_ext" source="t_frm" target="frm"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="det" value="&lt;b&gt;Face Detector&lt;/b&gt; (MAIN face path, from draft 2)&lt;br&gt;MediaPipe Face Detector (BlazeFace short-range, bundled WASM + model, no CDN), ~1-2 ms per tile, in a Worker inside a hidden extension iframe (own origin + CSP); the content script transfers ImageBitmaps to it. Smooths boxes, one track per tile; head anchor from eye/nose key points. No face → null → Frame mode; tiles beyond 6 → Frame mode. Manifest needs wasm-unsafe-eval. No network, $0.&lt;br&gt;&lt;i&gt;W3 · test: Fake Meet synthetic faces, IoU ≥ 0.7.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fontSize=10;strokeColor=#c92a2a;strokeWidth=3;" vertex="1" parent="L_ext"><mxGeometry x="360" y="800" width="300" height="150" as="geometry"/></mxCell><mxCell id="t_det" value="faces.update (in-tab, engine-agnostic)&#10;{ tile_id, frame_ts_ms,&#10;  engine: &quot;mediapipe&quot;|&quot;yunet&quot;|&quot;sam&quot;,&#10;  space: { frame_w, frame_h },&#10;  face: { box: [x,y,w,h] 0..1,&#10;          head_anchor: [x,y],&#10;          conf } | null }&#10;null -&gt; Overlay uses Frame mode" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=6;fontSize=9;fontFamily=Courier New;" vertex="1" parent="L_ext"><mxGeometry x="20" y="800" width="300" height="150" as="geometry"/></mxCell><mxCell id="p_det" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="L_ext" source="t_det" target="det"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ovl" value="&lt;b&gt;Overlay&lt;/b&gt;&lt;br&gt;Build from &lt;i&gt;docs/ui/overlay-mix-b.html&lt;/i&gt; (Mix B, black borders). Projects source-space boxes to screen (object-fit math). Name above the head = the halo; ≤ 3 glass bubbles (point / question / decision / pushback), fade ~60 s, same id replaces in place. Urgent items get a mark (tags.set; look: drafts pending). Notes-ready toast at the end. Provisional points dimmed, moved on corrects. Status chip + consent badge. ACKs + dedupes by id.&lt;br&gt;&lt;font color=&quot;#c92a2a&quot;&gt;&lt;i&gt;✂ 6 Arabic polish beyond RTL&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;i&gt;W3 · test: Replayer B → DOM ±4 px.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fontSize=10;strokeColor=#c92a2a;strokeWidth=3;" vertex="1" parent="L_ext"><mxGeometry x="360" y="990" width="300" height="150" as="geometry"/></mxCell><mxCell id="adp_frm" value="tile rects + &amp;lt;video&amp;gt; refs (in-tab)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitPerimeter=0;entryPerimeter=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;dashed=1;strokeColor=#c92a2a;strokeWidth=3;" edge="1" parent="L_ext" source="adp" target="frm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="frm_det" value="TileFrame (in-tab)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitPerimeter=0;entryPerimeter=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;dashed=1;strokeColor=#c92a2a;strokeWidth=3;" edge="1" parent="L_ext" source="frm" target="det"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="det_ovl" value="faces.update (in-tab, every frame)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitPerimeter=0;entryPerimeter=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;dashed=1;strokeColor=#c92a2a;strokeWidth=3;" edge="1" parent="L_ext" source="det" target="ovl"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="L_be" value="Backend: one FastAPI modular monolith on this PC (asyncio EventBus, SQLite + FTS5 + local files)" style="swimlane;startSize=30;html=1;fontSize=13;fontStyle=1;fillColor=#fafafa;strokeColor=#999999;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1620" y="640" width="1140" height="1560" as="geometry"/></mxCell><mxCell id="gw" value="&lt;b&gt;Gateway&lt;/b&gt;&lt;br&gt;The backend's only front door. W2.&lt;br&gt;&lt;br&gt;Pairing: serves /pair (6-digit code → token). The first WS message must be pair.hello with a valid token; Origin must be the extension id.&lt;br&gt;&lt;br&gt;&lt;b&gt;Data side&lt;/b&gt; (binary, no ACK): audio by stream → Transcriber (ordered, lossless); rec chunks → Recorder. No video frames ever arrive here.&lt;br&gt;&lt;br&gt;&lt;b&gt;Control side&lt;/b&gt;: validates every envelope against /contracts, dedupes by id, publishes on the EventBus, then ACKs (ACK = accepted on the bus).&lt;br&gt;&lt;br&gt;Builds system.status from llm.health, ASR state and tagger health; pushes it every 5 s and on change. Synthesizes meeting.ended on a dead WS.&lt;br&gt;&lt;br&gt;Serves the Notes page over HTTP; POST /api/tags → tags.set (source: user).&lt;br&gt;&lt;br&gt;&lt;i&gt;W2 · test: L0 contract tests + chaos replay (drop ACK, duplicate) → exactly-once rows in the Event Store.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fontSize=10;strokeColor=#c92a2a;strokeWidth=3;" vertex="1" parent="L_be"><mxGeometry x="40" y="40" width="240" height="1480" as="geometry"/></mxCell><mxCell id="tr" value="&lt;b&gt;Transcriber&lt;/b&gt; (converter)&lt;br&gt;Two Voice sessions (tab: diarization, mic: endpointing &quot;you&quot;), languageBias Arabic + English. Maps ASR offsets to the meeting clock (ts = anchor_ts + offset). Rotates before 60 min.&lt;br&gt;&lt;i&gt;W2 · test: FakeASR + fixture: t_start ±200 ms of truth; forced rotation.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fontSize=10;strokeColor=#c92a2a;strokeWidth=3;" vertex="1" parent="L_be"><mxGeometry x="380" y="40" width="300" height="150" as="geometry"/></mxCell><mxCell id="t_tr" value="transcript.partial | .final&#10;{ turn_id, stream: &quot;tab&quot;|&quot;mic&quot;,&#10;  speaker: &quot;A&quot;|&quot;B&quot;|...|&quot;you&quot;,&#10;  text, lang, ts_start_ms, ts_end_ms,&#10;  final, session_seq }&#10;transcriber.rotated {session_seq}" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=6;fontSize=9;fontFamily=Courier New;" vertex="1" parent="L_be"><mxGeometry x="760" y="40" width="340" height="120" as="geometry"/></mxCell><mxCell id="p_tr" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="L_be" source="t_tr" target="tr"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="co" value="&lt;b&gt;Correlator&lt;/b&gt;&lt;br&gt;Before lock: a turn goes to the tile highlighted when it started (provisional). Votes on overlap with speaker.active; locks after 3 agreeing turns; a disagreeing lock emits corrects[]. Two tiles lit at once → turn marked overlap, stays provisional. Drops a 'you' line that repeats a tab line within 2 s (echo).&lt;br&gt;&lt;i&gt;W2 · test: wrong-highlight fixture → golden shows the fix.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fontSize=10;strokeColor=#c92a2a;strokeWidth=3;" vertex="1" parent="L_be"><mxGeometry x="380" y="230" width="300" height="150" as="geometry"/></mxCell><mxCell id="t_co" value="speaker.mapped&#10;{ speaker, session_seq, tile_id,&#10;  name, confidence,&#10;  locked: bool, overlap: bool,&#10;  corrects?: [turn_id] }" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=6;fontSize=9;fontFamily=Courier New;" vertex="1" parent="L_be"><mxGeometry x="760" y="230" width="340" height="120" as="geometry"/></mxCell><mxCell id="p_co" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="L_be" source="t_co" target="co"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ins" value="&lt;b&gt;Insight&lt;/b&gt;&lt;br&gt;On a pause (≤ 1 call / 3 s / speaker): Spark Open, validate JSON, retry once, else Spark 1.3 contributor; failover if &gt; 1 of the last 10 calls &gt; 4 s. Points in the viewer's language + original quote, with a first-guess urgency + is_action in the same call; on corrects[] it re-upserts with replaces.&lt;br&gt;&lt;i&gt;W2 · test: FakeLLM latency + bad-JSON knobs.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fontSize=10;strokeColor=#c92a2a;strokeWidth=3;" vertex="1" parent="L_be"><mxGeometry x="380" y="420" width="300" height="150" as="geometry"/></mxCell><mxCell id="t_ins" value="points.upsert&#10;{ point_id, tile_id, speaker_name,&#10;  kind: point|question|decision|pushback,&#10;  text, lang, quote, turn_ids[], rank,&#10;  attribution: provisional|locked,&#10;  urgency?: urgent|medium|later,&#10;  is_action, replaces?: point_id }&#10;llm.health { engine, p90_ms }" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=6;fontSize=9;fontFamily=Courier New;" vertex="1" parent="L_be"><mxGeometry x="760" y="420" width="340" height="120" as="geometry"/></mxCell><mxCell id="p_ins" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="L_be" source="t_ins" target="ins"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cls" value="&lt;b&gt;Classifier&lt;/b&gt; (urgency + category)&lt;br&gt;Off the critical path: never delays a point. &lt;b&gt;Live:&lt;/b&gt; every 10 s, if new points arrived, one batched call confirms or corrects Insight's first-guess urgency + category; the overlay updates the bubble in place. &lt;b&gt;At meeting end:&lt;/b&gt; tags every action item (urgency, assigned/suggested). A user re-tag (source: user) always wins.&lt;br&gt;&lt;font color=&quot;#c92a2a&quot;&gt;&lt;i&gt;ring 2&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;i&gt;W4 · test: FakeLLM canned tags; schema check.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fontSize=10;" vertex="1" parent="L_be"><mxGeometry x="380" y="610" width="300" height="150" as="geometry"/></mxCell><mxCell id="t_cls" value="tags.set { target: &quot;point&quot;|&quot;action&quot;,&#10;  target_id, category: decision|&#10;   open_question|pushback|point,&#10;  urgency?: urgent|medium|later,&#10;  owner_status?: assigned|suggested,&#10;  source: &quot;model&quot;|&quot;user&quot;, model }" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=6;fontSize=9;fontFamily=Courier New;" vertex="1" parent="L_be"><mxGeometry x="760" y="610" width="340" height="120" as="geometry"/></mxCell><mxCell id="p_cls" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="L_be" source="t_cls" target="cls"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="nb" value="&lt;b&gt;Notes Builder&lt;/b&gt;&lt;br&gt;On meeting.ended: full log + roles + live points into the notes template (Spark 1.3 contributor, schema enforced). Per person: why they matter, relevant + own points, action items (assigned when said aloud, otherwise suggested by role).&lt;br&gt;&lt;font color=&quot;#c92a2a&quot;&gt;&lt;i&gt;✂ 4 per-person depth (keep live points + actions)&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;i&gt;W4 · test: FakeLLM canned notes; validates notes.ready.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fontSize=10;" vertex="1" parent="L_be"><mxGeometry x="380" y="800" width="300" height="150" as="geometry"/></mxCell><mxCell id="t_nb" value="notes.ready&#10;{ meeting_id, project_id?, url,&#10;  people: [{ name, role, why,&#10;   relevant_points[], own_points[],&#10;   actions: [{ action_id, text, owner,&#10;    status: assigned|suggested }] }] }" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=6;fontSize=9;fontFamily=Courier New;" vertex="1" parent="L_be"><mxGeometry x="760" y="800" width="340" height="120" as="geometry"/></mxCell><mxCell id="p_nb" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="L_be" source="t_nb" target="nb"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="es" value="&lt;b&gt;Event Store&lt;/b&gt;&lt;br&gt;Appends every accepted envelope to SQLite (WAL); id UNIQUE is the second dedupe line. FTS5 over transcript + point text. Meetings indexed by project_id (roadmap: Recall per project). Kept until deleted.&lt;br&gt;&lt;font color=&quot;#c92a2a&quot;&gt;&lt;i&gt;ring 2&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;i&gt;W2 · test: duplicate chaos → no duplicate rows.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fontSize=10;" vertex="1" parent="L_be"><mxGeometry x="380" y="990" width="300" height="150" as="geometry"/></mxCell><mxCell id="t_es" value="events (SQLite)&#10;seq PK, id UNIQUE, type, time,&#10;meetingid, source, data JSON&#10;meetings(meetingid, project_id, t0)&#10;+ FTS5(transcript text, point text)" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=6;fontSize=9;fontFamily=Courier New;" vertex="1" parent="L_be"><mxGeometry x="760" y="990" width="340" height="120" as="geometry"/></mxCell><mxCell id="p_es" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="L_be" source="t_es" target="es"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ns" value="&lt;b&gt;Notes Service&lt;/b&gt;&lt;br&gt;Meeting + person pages from SQLite, FTS5 search, Markdown export, links to the transcript line and recording time. Merges tags (user over model); groups actions Urgent / Medium / Later.&lt;br&gt;&lt;font color=&quot;#c92a2a&quot;&gt;&lt;i&gt;ring 2&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;i&gt;W4 · test: HTTP snapshots on a replay-seeded DB.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fontSize=10;" vertex="1" parent="L_be"><mxGeometry x="380" y="1180" width="300" height="150" as="geometry"/></mxCell><mxCell id="t_ns" value="search hit&#10;{ meeting_id, point_id | turn_id,&#10;  snippet, ts_ms }" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=6;fontSize=9;fontFamily=Courier New;" vertex="1" parent="L_be"><mxGeometry x="760" y="1180" width="340" height="120" as="geometry"/></mxCell><mxCell id="p_ns" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="L_be" source="t_ns" target="ns"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="rec" value="&lt;b&gt;Recorder&lt;/b&gt; (converter)&lt;br&gt;webm chunks to local files on this PC with a ts_ms index on the meeting clock. Kept until you delete them; cloud upload = later option via API.&lt;br&gt;&lt;font color=&quot;#c92a2a&quot;&gt;&lt;i&gt;✂ 3 drop video, keep transcript links&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;i&gt;W4 · test: replayed rec chunks → file + index; fake clock for expiry.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fontSize=10;" vertex="1" parent="L_be"><mxGeometry x="380" y="1370" width="300" height="150" as="geometry"/></mxCell><mxCell id="t_rec" value="recording&#10;{ meeting_id, path, t0_ms,&#10;  ts_ms_index }&#10;kept until deleted" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=6;fontSize=9;fontFamily=Courier New;" vertex="1" parent="L_be"><mxGeometry x="760" y="1370" width="340" height="120" as="geometry"/></mxCell><mxCell id="p_rec" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="L_be" source="t_rec" target="rec"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g_tr" value="DATA: binary audio by stream" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitPerimeter=0;entryPerimeter=0;exitX=1;exitY=0.0507;entryX=0;entryY=0.5;strokeColor=#c92a2a;strokeWidth=3;" edge="1" parent="L_be" source="gw" target="tr"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="g_co" value="tiles.snapshot, speaker.active, meeting.*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitPerimeter=0;entryPerimeter=0;exitX=1;exitY=0.1791;entryX=0;entryY=0.5;strokeColor=#c92a2a;strokeWidth=3;" edge="1" parent="L_be" source="gw" target="co"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="g_ins" value="meeting.context" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitPerimeter=0;entryPerimeter=0;exitX=1;exitY=0.2905;entryX=0;entryY=0.3333;" edge="1" parent="L_be" source="gw" target="ins"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ins_g" value="points.upsert, llm.health ⇄ ACK" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitPerimeter=0;entryPerimeter=0;exitX=0;exitY=0.6667;entryX=1;entryY=0.3243;strokeColor=#c92a2a;strokeWidth=3;" edge="1" parent="L_be" source="ins" target="gw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="g_cls" value="user re-tag → tags.set ⇄ ACK" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitPerimeter=0;entryPerimeter=0;exitX=1;exitY=0.4358;entryX=0;entryY=0.5;" edge="1" parent="L_be" source="gw" target="cls"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="g_es" value="every envelope (bus tap) ⇄ ACK = accepted" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitPerimeter=0;entryPerimeter=0;exitX=1;exitY=0.6926;entryX=0;entryY=0.5;" edge="1" parent="L_be" source="gw" target="es"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="g_ns" value="HTTP route" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitPerimeter=0;entryPerimeter=0;exitX=1;exitY=0.8209;entryX=0;entryY=0.5;" edge="1" parent="L_be" source="gw" target="ns"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="g_rec" value="DATA: binary rec chunks" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitPerimeter=0;entryPerimeter=0;exitX=1;exitY=0.9493;entryX=0;entryY=0.5;" edge="1" parent="L_be" source="gw" target="rec"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="tr_co" value="transcript.* ⇄ ACK" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitPerimeter=0;entryPerimeter=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#c92a2a;strokeWidth=3;" edge="1" parent="L_be" source="tr" target="co"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="co_ins" value="speaker.mapped (+ corrects[]) ⇄ ACK" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitPerimeter=0;entryPerimeter=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#c92a2a;strokeWidth=3;" edge="1" parent="L_be" source="co" target="ins"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ins_cls" value="points.upsert (bus) ⇄ ACK" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitPerimeter=0;entryPerimeter=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="L_be" source="ins" target="cls"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="nb_cls" value="notes.ready actions[] ⇄ ACK" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitPerimeter=0;entryPerimeter=0;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="L_be" source="nb" target="cls"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="es_nb" value="meeting.ended: read full log" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitPerimeter=0;entryPerimeter=0;exitX=0.3;exitY=0;entryX=0.3;entryY=1;" edge="1" parent="L_be" source="es" target="nb"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="nb_es" value="notes.ready ⇄ ACK" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitPerimeter=0;entryPerimeter=0;exitX=0.7;exitY=1;entryX=0.7;entryY=0;" edge="1" parent="L_be" source="nb" target="es"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="es_ns" value="SQLite read (FTS5, tags)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitPerimeter=0;entryPerimeter=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="L_be" source="es" target="ns"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rec_ns" value="recording index" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitPerimeter=0;entryPerimeter=0;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="L_be" source="rec" target="ns"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_setup" value="pair.hello, meeting.context ⇄ ACK" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitPerimeter=0;entryPerimeter=0;exitX=1;exitY=0.5;entryX=0;entryY=0.0507;" edge="1" parent="1" source="setup" target="gw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_cap" value="DATA plane: binary audio + rec chunks (ts_ms), no envelope, no ACK" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitPerimeter=0;entryPerimeter=0;exitX=1;exitY=0.5;entryX=0;entryY=0.1791;strokeColor=#c92a2a;strokeWidth=3;" edge="1" parent="1" source="cap" target="gw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_adp" value="tiles.snapshot, speaker.active,&lt;br&gt;meeting.started/ended ⇄ ACK" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitPerimeter=0;entryPerimeter=0;exitX=1;exitY=0.5;entryX=0;entryY=0.3074;strokeColor=#c92a2a;strokeWidth=3;" edge="1" parent="1" source="adp" target="gw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_ovl" value="points.upsert, tags.set, speaker.mapped,&lt;br&gt;system.status, notes.ready ⇄ ACK from Overlay" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitPerimeter=0;entryPerimeter=0;exitX=0;exitY=0.6926;entryX=1;entryY=0.5;strokeColor=#c92a2a;strokeWidth=3;" edge="1" parent="1" source="gw" target="ovl"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="L_api" value="External model APIs (keys only in backend .env, never in CI)" style="swimlane;startSize=30;html=1;fontSize=13;fontStyle=1;fillColor=#fafafa;strokeColor=#999999;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="2820" y="640" width="340" height="1040" as="geometry"/></mxCell><mxCell id="voice" value="&lt;b&gt;Muse Voice Transcribe&lt;/b&gt; (Meta API)&lt;br&gt;wss://api.meta.ai/v1/asr/realtime&lt;br&gt;muse-voice-transcribe-1.0&lt;br&gt;tab session: diarization&lt;br&gt;mic session: endpointing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fontSize=10;strokeColor=#c92a2a;strokeWidth=3;" vertex="1" parent="L_api"><mxGeometry x="20" y="100" width="300" height="140" as="geometry"/></mxCell><mxCell id="sparkopen" value="&lt;b&gt;Spark Open (Baseten) · Insight default&lt;/b&gt;&lt;br&gt;meta-models/muse-spark-open-1026, reasoning_effort low&lt;br&gt;json_schema NOT enforced: validate&lt;br&gt;Open-weights prize entry · basic tier 15 RPM: ask for 120" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fontSize=10;strokeColor=#c92a2a;strokeWidth=3;" vertex="1" parent="L_api"><mxGeometry x="20" y="480" width="300" height="140" as="geometry"/></mxCell><mxCell id="contrib" value="&lt;b&gt;muse-spark-1.3-contributor&lt;/b&gt; (Meta API)&lt;br&gt;api.meta.ai/v1 · json_schema enforced&lt;br&gt;$0.10 in / $0.20 out per 1M tokens, 150 RPM&lt;br&gt;&lt;br&gt;One model for three jobs:&lt;br&gt;· Insight failover (slow or bad JSON)&lt;br&gt;· Classifier: live every 10 s + meeting end&lt;br&gt;· Notes Builder: once per meeting&lt;br&gt;&lt;br&gt;Meta may train on the content. Fine for Halo: open source, demo meetings hold no real data (Karim, 2026-10-30). The consent badge still says so." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fontSize=10;" vertex="1" parent="L_api"><mxGeometry x="20" y="670" width="300" height="330" as="geometry"/></mxCell><mxCell id="tr_voice" value="paced PCM → turns (realtime WS)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitPerimeter=0;entryPerimeter=0;exitX=1;exitY=0.97;entryX=0;entryY=0.607;strokeColor=#c92a2a;strokeWidth=3;" edge="1" parent="1" source="tr" target="voice"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ins_open" value="chat.completions, json_schema" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitPerimeter=0;entryPerimeter=0;exitX=1;exitY=0.97;entryX=0;entryY=0.607;strokeColor=#c92a2a;strokeWidth=3;" edge="1" parent="1" source="ins" target="sparkopen"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="cls_c" value="batched tags (10 s + end)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitPerimeter=0;entryPerimeter=0;exitX=1;exitY=0.97;entryX=0;entryY=0.2576;" edge="1" parent="1" source="cls" target="contrib"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="nb_13" value="notes template" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitPerimeter=0;entryPerimeter=0;exitX=1;exitY=0.97;entryX=0;entryY=0.8333;" edge="1" parent="1" source="nb" target="contrib"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="fail" value="Insight fails over:&lt;br&gt;slow (&amp;gt;1 of 10 &amp;gt; 4 s),&lt;br&gt;bad JSON twice or 429" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitPerimeter=0;entryPerimeter=0;exitX=1;exitY=0.5;entryX=1;entryY=0.15;dashed=1;" edge="1" parent="L_api" source="sparkopen" target="contrib"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="332" y="550"/><mxPoint x="332" y="720"/></Array></mxGeometry></mxCell><mxCell id="L_fake" value="Fake engines (Wave 1)" style="swimlane;startSize=30;html=1;fontSize=13;fontStyle=1;fillColor=#f7f1fa;strokeColor=#9673a6;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="2820" y="1720" width="340" height="330" as="geometry"/></mxCell><mxCell id="fasr" value="&lt;b&gt;FakeASR&lt;/b&gt;&lt;br&gt;Speaks the Voice realtime WS protocol. Emits the fixture's scripted turns at offsets matching the audio it gets. Knobs: latency, forced session drop, AR/EN code-switch." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fontSize=10;" vertex="1" parent="L_fake"><mxGeometry x="20" y="40" width="300" height="130" as="geometry"/></mxCell><mxCell id="fllm" value="&lt;b&gt;FakeLLM&lt;/b&gt;&lt;br&gt;OpenAI-compatible /v1/chat/completions; stands in for Spark Open and Spark 1.3 contributor. Canned JSON per fixture turn. Knobs: latency spread (forces &amp;gt;4 s failover), invalid-JSON rate (forces retry)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fontSize=10;" vertex="1" parent="L_fake"><mxGeometry x="20" y="185" width="300" height="130" as="geometry"/></mxCell><mxCell id="f_api" value="drop-in: same wire protocol&lt;br&gt;(HALO_ENGINES=fake, per engine)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitPerimeter=0;entryPerimeter=0;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="L_fake" target="L_api"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="stretch" value="&lt;b&gt;Stretch only · SAM 3.1 Face Refiner&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#c92a2a&quot;&gt;&lt;i&gt;✂ 1: first to cut. Not in the MVP.&lt;/i&gt;&lt;/font&gt;&lt;br&gt;If time allows: SAM 3.1 masks for a &quot;name tucks behind the head&quot; effect. Plugs in as another faces.update engine (engine: &quot;sam&quot;), so nothing else changes. Runs on the local 3080 Ti, or Modal ($30, optional, never leave a GPU warm). Would be the only thing that ever sends a frame off the tab." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fontSize=10;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="2820" y="2090" width="340" height="210" as="geometry"/></mxCell><mxCell id="questions" value="&lt;b&gt;Decided with Karim (2026-10-30)&lt;/b&gt;&lt;br&gt;· Test rig: lean, built in parallel with W2/W3.&lt;br&gt;· Golden truth: freeze one real-engine run, Karim spot-checks it.&lt;br&gt;· Fixtures: Karim records 2-3 bilingual calls.&lt;br&gt;· Urgency: BOTH. Insight's first guess arrives with the bubble; the Classifier corrects it live every 10 s (only if new points) and tags all action items at meeting end.&lt;br&gt;· Every Spark 1.3 call uses muse-spark-1.3-contributor (Insight failover, Classifier, Notes Builder). Training is fine: open source, no real data.&lt;br&gt;· Pairing: Origin check + one-time 6-digit code.&lt;br&gt;· License: MIT.&lt;br&gt;&lt;br&gt;&lt;b&gt;Engineering defaults (Claude, from best practice)&lt;/b&gt;&lt;br&gt;· Face Detector = MediaPipe (official npm, eye/nose key points), WASM + model bundled (MV3 forbids remote code).&lt;br&gt;· Detector runs in a Worker inside a hidden extension iframe; the content script transfers ImageBitmaps (a content script can't start an extension Worker on Meet's page).&lt;br&gt;· Path B paints our overlay out of each crop (no flicker).&lt;br&gt;· Capture starts from the toolbar popup (Chrome's user-gesture rule); tab audio is replayed so you still hear the call.&lt;br&gt;&lt;br&gt;&lt;b&gt;Still open&lt;/b&gt;&lt;br&gt;1. &lt;b&gt;Karim runs the 3 day-0 probes&lt;/b&gt;: meet-overlay (path A vs B), spark-latency (is p90 &amp;lt; 4 s real?), arabic-asr.&lt;br&gt;2. Overlay look for the urgency mark: drafts first (no credit spend).&lt;br&gt;3. Recordings: local, kept until deleted (Karim). Headset required. No X post." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="3220" y="640" width="520" height="560" as="geometry"/></mxCell><mxCell id="changes" value="&lt;b&gt;What changed from draft 4&lt;/b&gt;&lt;br&gt;1. &lt;b&gt;Faces moved into the browser&lt;/b&gt; (draft 2): Face Detector (MediaPipe/YuNet) is the main path. No GPU worker, no frame traffic, no FakeSAM. Frames never leave the browser.&lt;br&gt;2. Frame Source: path A (tile &amp;lt;video&amp;gt;) is the main path; path B (tab-capture crop, draft 3) is fallback only, picked by the meet-overlay probe.&lt;br&gt;3. faces.update is in-tab only and engine-agnostic (engine: mediapipe | yunet | sam), so SAM 3.1 can plug in later as the ✂1 stretch.&lt;br&gt;4. &lt;b&gt;Two-plane rule&lt;/b&gt; (draft 5) written into /contracts: binary audio + rec = data plane, no ACK; envelopes = control plane, ⇄ ACK; Transcriber + Recorder are the only converters. Gateway drawn with a data side and a control side.&lt;br&gt;5. New &lt;b&gt;Classifier&lt;/b&gt; module on muse-spark-1.3-contributor: live every 10 s + at meeting end, tags.set with category + urgency; Insight adds a first-guess urgency; user re-tag wins. One contributor model box replaces Spark 1.3.&lt;br&gt;6. project_id (optional) on meeting.context, stored with each meeting.&lt;br&gt;7. Platform-neutral &lt;b&gt;MeetingAdapter&lt;/b&gt; interface; meeting.started carries platform.&lt;br&gt;8. Critical path in thick red, ✂ cut lines and ring-2 tags on each module (DECISIONS §8).&lt;br&gt;9. ACK status back to ok | error (DECISIONS §4); a duplicate is re-ACKed ok and dropped.&lt;br&gt;10. Consent notice + badge moved onto the Setup Panel and Overlay (never cut)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="3220" y="1230" width="520" height="600" as="geometry"/></mxCell><mxCell id="L_fmeet" value="Fake Meet page (Wave 1)" style="swimlane;startSize=30;html=1;fontSize=13;fontStyle=1;fillColor=#f7f1fa;strokeColor=#9673a6;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="780" y="1850" width="700" height="290" as="geometry"/></mxCell><mxCell id="pw" value="&lt;b&gt;Playwright harness&lt;/b&gt;&lt;br&gt;Loads the unpacked extension into Chromium, opens the Fake Meet page, points the extension at Replayer mode B. Asserts overlay DOM positions against the painted ground truth (±4 px), Face Detector IoU on synthetic faces, screenshot diffs, and the envelopes + binary the extension sends. Runs in CI as L3, no keys." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fontSize=10;" vertex="1" parent="L_fmeet"><mxGeometry x="20" y="40" width="300" height="220" as="geometry"/></mxCell><mxCell id="fmeet" value="&lt;b&gt;Fake Meet page&lt;/b&gt;&lt;br&gt;Static page copying Meet's DOM anchors (data-participant-id, name spans, self tile, speaking-highlight toggles). Tiles play fixture video or synthetic faces via canvas MediaStreams, object-fit cover at mismatched aspect ratios. Modes: video | canvas-only (no &amp;lt;video&amp;gt;, forces path B). Scripted layouts, join/leave, screen share. Grows from rig/fake_meet/seed-fixture.html (the day-0 probe page)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fontSize=10;" vertex="1" parent="L_fmeet"><mxGeometry x="360" y="40" width="300" height="220" as="geometry"/></mxCell><mxCell id="pw_fm" value="drives" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitPerimeter=0;entryPerimeter=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="L_fmeet" source="pw" target="fmeet"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="fm_ext" value="hosts the real content scripts" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitPerimeter=0;entryPerimeter=0;exitX=0.5;exitY=0;entryX=0.7286;entryY=1;" edge="1" parent="1" source="fmeet" target="L_ext"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="L_rep" value="Replay rig (Wave 1)" style="swimlane;startSize=30;html=1;fontSize=13;fontStyle=1;fillColor=#f7f1fa;strokeColor=#9673a6;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1620" y="2240" width="700" height="500" as="geometry"/></mxCell><mxCell id="rp" value="&lt;b&gt;Replayer&lt;/b&gt;&lt;br&gt;Mode A (fake extension): pairs with a test token, sends meeting.started, envelopes and binary audio + rec chunks at their recorded ts_ms (1× real time, or fast on a virtual clock), honours ACK + resend.&lt;br&gt;Mode B (fake backend): replays recorded backend → extension events to the extension on the Fake Meet page.&lt;br&gt;Chaos knobs from the contract kit." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fontSize=10;" vertex="1" parent="L_rep"><mxGeometry x="40" y="50" width="290" height="210" as="geometry"/></mxCell><mxCell id="chk" value="&lt;b&gt;Golden asserts&lt;/b&gt; (lean: plain tests, no checker tool)&lt;br&gt;expected.jsonl = one real-engine run on the fixture, frozen, then spot-checked by Karim. Tests assert a run (events.sqlite + what the Replayer received) against it: ts ±300 ms, fuzzy text, ids ignored, order per tile. CI gate (L2) on every PR touching the backend." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fontSize=10;" vertex="1" parent="L_rep"><mxGeometry x="390" y="50" width="290" height="210" as="geometry"/></mxCell><mxCell id="fcap" value="&lt;b&gt;Fixture Capture&lt;/b&gt;&lt;br&gt;Record mode of the real extension on a real call (consent notice on): dumps exactly what it would send, with ts_ms, plus tile frames for detector tests. Synthetic fixture in W1." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;fontSize=10;" vertex="1" parent="L_rep"><mxGeometry x="40" y="300" width="290" height="170" as="geometry"/></mxCell><mxCell id="t_fix" value="fixtures/&lt;name&gt;/&#10;  meta.json (tiles, roles, t0_ms)&#10;  tab.pcm  mic.pcm  rec.webm&#10;  envelopes.jsonl (ts_ms)&#10;  frames/&lt;tile&gt;/&lt;ts_ms&gt;.jpg&#10;  asr_script.jsonl -&gt; FakeASR&#10;  llm_script.jsonl -&gt; FakeLLM&#10;  faces.jsonl -&gt; detector IoU truth&#10;  expected.jsonl   -&gt; checker" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=6;fontSize=9;fontFamily=Courier New;" vertex="1" parent="L_rep"><mxGeometry x="390" y="300" width="290" height="170" as="geometry"/></mxCell><mxCell id="p_fcap" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="L_rep" source="t_fix" target="fcap"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="rp_chk" value="results" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitPerimeter=0;entryPerimeter=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="L_rep" source="rp" target="chk"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="fcap_rp" value="fixtures/" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitPerimeter=0;entryPerimeter=0;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="L_rep" source="fcap" target="rp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rp_gw" value="mode A: plays the extension ⇄ ACK" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitPerimeter=0;entryPerimeter=0;exitX=0.2759;exitY=0;entryX=0.3333;entryY=1;" edge="1" parent="1" source="rp" target="gw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rp_fm" value="mode B: plays the backend&lt;br&gt;to the extension ⇄ ACK" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitPerimeter=0;entryPerimeter=0;exitX=0;exitY=0.2857;entryX=1;entryY=0.7273;" edge="1" parent="1" source="rp" target="fmeet"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>