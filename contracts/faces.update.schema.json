{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://halo.local/contracts/faces.update",
  "title": "faces.update",
  "type": "object",
  "properties": {
    "tile_id": {
      "type": "string"
    },
    "frame_ts_ms": {
      "type": "integer",
      "minimum": 0
    },
    "engine": {
      "type": "string",
      "enum": [
        "mediapipe",
        "yunet",
        "sam"
      ]
    },
    "space": {
      "type": "object",
      "properties": {
        "frame_w": {
          "type": "integer",
          "minimum": 0
        },
        "frame_h": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "frame_w",
        "frame_h"
      ],
      "additionalProperties": false
    },
    "face": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "box": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "minItems": 4,
          "maxItems": 4
        },
        "head_anchor": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "minItems": 2,
          "maxItems": 2
        },
        "conf": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "box",
        "head_anchor",
        "conf"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "tile_id",
    "frame_ts_ms",
    "engine",
    "space",
    "face"
  ],
  "additionalProperties": false
}
