{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://halo.local/contracts/coach.tips",
  "title": "coach.tips",
  "description": "Meeting coach: 1-3 short tips on how to steer the meeting, from the whole meeting so far, about once a minute. Each new event replaces the last.",
  "type": "object",
  "properties": {
    "tips": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      },
      "minItems": 1,
      "maxItems": 3
    },
    "lang": {
      "type": "string",
      "enum": [
        "en",
        "ar"
      ]
    }
  },
  "required": [
    "tips",
    "lang"
  ],
  "additionalProperties": false
}
