{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://halo.local/contracts/claim.checked",
  "title": "claim.checked",
  "description": "Fact Check: one spoken claim checked against the live web by Muse Spark search grounding, or against the viewer's reference notes and the earlier meetings of the same notes-page Project (notes_from says which meeting). sources are the URLs the search returned, never model-written; notes_quote is a sentence found in the notes. At least one of the two is present.",
  "type": "object",
  "properties": {
    "point_id": {
      "type": "string",
      "format": "uuid"
    },
    "claim": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "speaker_name": {
      "type": "string"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "supported",
        "disputed"
      ]
    },
    "note": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      },
      "minItems": 0,
      "maxItems": 3
    },
    "notes_quote": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "description": "The sentence from the viewer's reference notes that settles the claim; present only when the notes did."
    },
    "notes_from": {
      "type": "object",
      "description": "Where notes_quote came from when it is a line from an earlier meeting in the same notes-page Project (absent for the viewer's own notes).",
      "properties": {
        "meeting_id": {
          "type": "string",
          "format": "uuid"
        },
        "subject": {
          "type": "string",
          "maxLength": 200
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "speaker": {
          "type": "string",
          "maxLength": 100
        }
      },
      "required": [
        "meeting_id",
        "subject",
        "date",
        "speaker"
      ],
      "additionalProperties": false
    },
    "lang": {
      "type": "string",
      "enum": [
        "en",
        "ar"
      ]
    }
  },
  "required": [
    "point_id",
    "claim",
    "speaker_name",
    "verdict",
    "note",
    "sources",
    "lang"
  ],
  "additionalProperties": false
}
