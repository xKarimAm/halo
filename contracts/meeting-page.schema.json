{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://halo.local/contracts/meeting-page",
  "title": "meeting-page",
  "type": "object",
  "properties": {
    "meeting": {
      "type": "object",
      "properties": {
        "meeting_id": {
          "type": "string",
          "format": "uuid"
        },
        "subject": {
          "type": "string"
        },
        "degraded": {
          "type": "boolean"
        },
        "project_id": {
          "type": "string"
        },
        "t0_ms": {
          "type": "integer",
          "minimum": 0
        },
        "title": {
          "type": "string",
          "description": "AI title from the Notes Builder at meeting end; absent until then (show subject)."
        },
        "summary": {
          "type": "string",
          "description": "AI 3-5 line summary from the Notes Builder at meeting end; absent until then."
        },
        "disagreements": {
          "type": "array",
          "maxItems": 5,
          "description": "AI (Notes Builder): where people disagreed, each side's view and how it ended.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "topic",
              "sides",
              "outcome"
            ],
            "properties": {
              "topic": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "sides": {
                "type": "array",
                "minItems": 1,
                "maxItems": 4,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "name",
                    "view"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    },
                    "view": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 160
                    }
                  }
                }
              },
              "outcome": {
                "type": "string",
                "enum": [
                  "settled",
                  "parked",
                  "open"
                ]
              },
              "resolution": {
                "type": "string",
                "maxLength": 200
              }
            }
          }
        },
        "in_progress": {
          "type": "boolean",
          "description": "True until meeting.ended: notes are not final yet."
        }
      },
      "required": [
        "meeting_id",
        "subject",
        "degraded",
        "t0_ms"
      ],
      "additionalProperties": false
    },
    "people": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "why": {
            "type": "string"
          },
          "relevant_points": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "own_points": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        },
        "required": [
          "name",
          "role",
          "why",
          "relevant_points",
          "own_points"
        ],
        "additionalProperties": false
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "action_id": {
            "type": "string",
            "format": "uuid"
          },
          "text": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "assigned",
              "suggested"
            ]
          },
          "urgency": {
            "type": "string",
            "enum": [
              "urgent",
              "medium",
              "later"
            ]
          },
          "point_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "action_id",
          "text",
          "owner",
          "status",
          "urgency",
          "point_id"
        ],
        "additionalProperties": false
      }
    },
    "points": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "point_id": {
            "type": "string",
            "format": "uuid"
          },
          "tile_id": {
            "type": "string"
          },
          "speaker_name": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "point",
              "question",
              "decision",
              "pushback"
            ]
          },
          "text": {
            "type": "string"
          },
          "quote": {
            "type": "string"
          },
          "turn_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "rank": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "urgency": {
            "type": "string",
            "enum": [
              "urgent",
              "medium",
              "later"
            ]
          },
          "is_action": {
            "type": "boolean"
          }
        },
        "required": [
          "point_id",
          "tile_id",
          "speaker_name",
          "kind",
          "text",
          "quote",
          "turn_ids",
          "rank",
          "is_action"
        ],
        "additionalProperties": false
      }
    },
    "transcript_lines": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "turn_id": {
            "type": "string",
            "format": "uuid"
          },
          "speaker_name": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "ts_start_ms": {
            "type": "integer",
            "minimum": 0
          },
          "ts_end_ms": {
            "type": "integer",
            "minimum": 0
          },
          "recording_offset_ms": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "turn_id",
          "speaker_name",
          "text",
          "ts_start_ms",
          "ts_end_ms",
          "recording_offset_ms"
        ],
        "additionalProperties": false
      }
    },
    "recording": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "start_ts_ms": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "path",
        "start_ts_ms"
      ],
      "additionalProperties": false
    },
    "fact_checks": {
      "type": "array",
      "description": "Claims checked on the web during the meeting; absent when none.",
      "items": {
        "type": "object",
        "properties": {
          "point_id": {
            "type": "string",
            "format": "uuid"
          },
          "claim": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "speaker_name": {
            "type": "string"
          },
          "verdict": {
            "type": "string",
            "enum": [
              "supported",
              "disputed"
            ]
          },
          "note": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            },
            "minItems": 0,
            "maxItems": 3
          },
          "notes_quote": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "description": "The sentence from the viewer's reference notes that settles the claim; present only when the notes did."
          }
        },
        "required": [
          "point_id",
          "claim",
          "speaker_name",
          "verdict",
          "note",
          "sources"
        ],
        "additionalProperties": false
      }
    },
    "coaching": {
      "type": "array",
      "description": "Everything the coach showed the viewer in this meeting, oldest first, each text once; absent when none.",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "alert": {
            "type": "boolean",
            "description": "True for an alert (act now), false for a steering tip."
          },
          "at_ms": {
            "type": "integer",
            "minimum": 0,
            "description": "When it was shown, from the meeting start."
          }
        },
        "required": [
          "text",
          "alert",
          "at_ms"
        ],
        "additionalProperties": false
      }
    },
    "visual_recap": {
      "type": "boolean",
      "description": "True when a Muse Image recap is saved for this meeting (GET /api/meetings/{id}/recap)."
    }
  },
  "required": [
    "meeting",
    "people",
    "points",
    "actions",
    "transcript_lines",
    "recording"
  ],
  "additionalProperties": false
}
