# Copy to .env and fill in. .env is git-ignored; keys never go anywhere else.
META_API_KEY=
BASETEN_API_KEY=
# Primary engine (Spark Open) host. Blank = Baseten defaults
# (https://inference.baseten.co/v1, meta-models/muse-spark-open-1026, key in BASETEN_API_KEY).
# Modal shared endpoint example:
#   HALO_PRIMARY_BASE_URL=https://<your-endpoint-url>/v1
#   HALO_PRIMARY_MODEL=meta-models/Muse-Spark-Open-816B-A42B
#   HALO_PRIMARY_KEY_VAR=MODAL_PROXY_TOKEN
#   MODAL_PROXY_TOKEN=wk-<id>.ws-<secret>
# Local OpenAI-compatible server example (llama.cpp / Ollama):
#   HALO_PRIMARY_BASE_URL=http://127.0.0.1:<port>/v1
#   HALO_PRIMARY_MODEL=<model name the server lists at /v1/models>
#   HALO_PRIMARY_KEY_VAR=LOCAL_LLM_KEY
#   LOCAL_LLM_KEY=<any non-empty placeholder>
HALO_PRIMARY_BASE_URL=
HALO_PRIMARY_MODEL=
# Name of the env var that holds the primary key (blank: BASETEN_API_KEY)
HALO_PRIMARY_KEY_VAR=
# 1 = offline fake engines for tests and the thin run (no keys, no network)
HALO_FAKES=0
# Comma list; any entry containing "fake" forces the fake engines (default: real)
HALO_ENGINES=
# Fake rig port for tests and parallel runs (unset: 18777)
HALO_FAKE_PORT=
# Chrome extension id for the Origin check (unset: the pinned id from the manifest key)
HALO_EXTENSION_ID=
# Where meetings, transcripts and recordings live (default: ./data)
HALO_DATA_DIR=
# Synthetic fixture dir for the fake engines (default: rig/fixtures/synthetic)
HALO_FIXTURE_DIR=
# Rig only (rig/replayer/joined.py, gate 2): set by the joined run itself
HALO_JOINED=
HALO_JOINED_DIR=
HALO_PAIR_CODE=
HALO_POINT_TEXT=
HALO_SPEAKER_TILE=
