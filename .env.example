# Copy to .env and fill in. .env is git-ignored; keys never go anywhere else.
META_API_KEY=
BASETEN_API_KEY=
# 1 = offline fake engines for tests and the thin run (no keys, no network)
HALO_FAKES=0
# Comma list; any entry containing "fake" forces the fake engines (default: real)
HALO_ENGINES=
# Chrome extension id for the Origin check (unset: any chrome-extension://
# origin passes until issue #27 pins the id)
HALO_EXTENSION_ID=
# Where meetings, transcripts and recordings live (default: ./data)
HALO_DATA_DIR=
# Synthetic fixture dir for the fake engines (default: rig/fixtures/synthetic)
HALO_FIXTURE_DIR=
