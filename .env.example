# Copy to .env and fill in. .env is git-ignored; keys never go anywhere else.
META_API_KEY=
BASETEN_API_KEY=
# 1 = offline fake engines for tests and the thin run (no keys, no network)
HALO_FAKES=0
# Comma list; any entry containing "fake" forces the fake engines (default: real)
HALO_ENGINES=
# Fake rig port for tests and parallel runs (unset: 18777)
HALO_FAKE_PORT=
# Chrome extension id for the Origin check (unset: the pinned id from the manifest key)
HALO_EXTENSION_ID=
# Where meetings, transcripts and recordings live (default: ./data)
HALO_DATA_DIR=
# Synthetic fixture dir for the fake engines (default: rig/fixtures/synthetic)
HALO_FIXTURE_DIR=
# Rig only (rig/replayer/joined.py, gate 2): set by the joined run itself
HALO_JOINED=
HALO_JOINED_DIR=
HALO_PAIR_CODE=
HALO_POINT_TEXT=
HALO_SPEAKER_TILE=
HALO_EXT_PATH=
HALO_MEET_PORT=
